<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}StreamCorner{% endblock %}</title>
    <link rel="icon" type="image/png" sizes="128x128" href="/assets/images/favicon.png?v=20260506-user">
    {% block stylesheets %}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;family=Space+Grotesk:wght@400;500;700;900&amp;display=swap" rel="stylesheet">
      <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@400;500;700&amp;display=swap" rel="stylesheet">
      <link rel="stylesheet" href="/assets/css/main.css?v=20260508-contact">
    {% endblock %}
  </head>
  <body class="{% block body_class %}page-shell{% endblock %}" {% block body_data %}{% endblock %}>
    {% block header %}
      {% include 'partials/_public_header.html.twig' %}
    {% endblock %}

    {% block body %}{% endblock %}

    {% block footer %}
      {% include 'partials/_public_footer.html.twig' %}
    {% endblock %}

    {% block javascripts %}
      <script src="/assets/js/main.js?v=20260507-stock" defer></script>
    {% endblock %}
  </body>
</html>
