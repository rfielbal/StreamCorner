<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>
			{% block title %}StreamCorner - {% endblock %}
		</title>
		{% block stylesheets %}
			<link href="https://bootswatch.com/5/lumen/bootstrap.min.css" rel="stylesheet">
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
			<style>
				body {
					background: #f7f9fb;
				}

				.navbar-brand {
					font-weight: 800;
					letter-spacing: .02em;
				}

				.stream-product-card {
					border: 0;
					border-radius: .75rem;
					overflow: hidden;
				}

				.stream-product-media {
					position: relative;
					aspect-ratio: 4 / 3;
					background: #eef3f7;
					overflow: hidden;
				}

				.stream-product-img,
				.stream-cart-media img {
					width: 100%;
					height: 100%;
					object-fit: cover;
				}

				.stream-product-placeholder {
					width: 100%;
					height: 100%;
					display: flex;
					align-items: center;
					justify-content: center;
					color: #7a8793;
					background: linear-gradient(135deg, #eef3f7, #ffffff);
				}

				.stream-favorite-btn {
					position: absolute;
					top: .75rem;
					right: .75rem;
					box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .12);
				}

				.stream-stock-badge {
					position: absolute;
					left: .75rem;
					bottom: .75rem;
				}

				.stream-sort-select {
					max-width: 220px;
				}

				.stream-cart-media {
					width: 112px;
					height: 92px;
					border-radius: .5rem;
					overflow: hidden;
					background: #eef3f7;
				}

				@media (max-width: 575.98px) {
					.stream-cart-media {
						width: 86px;
						height: 86px;
					}
				}
			</style>
		{% endblock %}
	</head>
	<body>
		<nav class="navbar navbar-expand-lg bg-light border-bottom" data-bs-theme="light">
			<div class="container-fluid">
				<a class="navbar-brand text-primary" href="{{ path('app_accueil') }}">StreamCorner</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarStreamCorner" aria-controls="navbarStreamCorner" aria-expanded="false" aria-label="Ouvrir la navigation">
					<span class="navbar-toggler-icon"></span>
				</button>

				<div class="collapse navbar-collapse" id="navbarStreamCorner">
					<ul class="navbar-nav me-auto">
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_accueil') }}">Accueil</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_mes_produits') }}">Boutique</a>
						</li>
						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">Univers</a>
							<div class="dropdown-menu">
								<a class="dropdown-item" href="{{ path('app_mes_produits') }}">Diffusion</a>
								<a class="dropdown-item" href="{{ path('app_mes_produits') }}">Audio</a>
								<a class="dropdown-item" href="{{ path('app_mes_produits') }}">Éclairage</a>
							</div>
						</li>
					</ul>

					<form action="{{ path('app_resultat') }}" method="get" class="d-flex me-lg-3 my-3 my-lg-0" role="search">
						<input class="form-control me-2" type="search" name="q" value="{{ app.request.query.get('q') }}" placeholder="Rechercher">
						<button class="btn btn-secondary" type="submit">
							<i class="bi bi-search"></i>
						</button>
					</form>

					<ul class="navbar-nav align-items-lg-center gap-lg-1">
						{% if not is_granted('IS_AUTHENTICATED_FULLY') %}
							<li class="nav-item">
								<a class="nav-link" href="{{ path('app_login') }}">Se connecter</a>
							</li>
							<li class="nav-item">
								<a class="btn btn-primary btn-sm ms-lg-2" href="{{ path('app_register') }}">S'inscrire</a>
							</li>
						{% else %}
							<li class="nav-item">
								<a class="nav-link" href="{{ path('app_liste_favoris') }}" title="Mes favoris">
									<i class="bi bi-heart"></i>
									<span class="d-lg-none ms-1">Favoris</span>
								</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" href="{{ path('app_panier') }}" title="Mon panier">
									<i class="bi bi-cart3"></i>
									<span class="d-lg-none ms-1">Panier</span>
								</a>
							</li>
							<li class="nav-item">
								<span class="nav-link text-muted small">{{ app.user.email }}</span>
							</li>
							<li class="nav-item">
								<a class="nav-link text-danger" href="{{ path('app_logout') }}" title="Se déconnecter">
									<i class="bi bi-box-arrow-right"></i>
									<span class="d-lg-none ms-1">Déconnexion</span>
								</a>
							</li>
						{% endif %}
					</ul>
				</div>
			</div>
		</nav>

		{% for message in app.flashes('notice') %}
			<div class="container mt-3">
				<div class="alert alert-info mb-0">{{ message }}</div>
			</div>
		{% endfor %}

		<main>
			{% block body %}StreamCorner{% endblock %}
		</main>

		{% block javascripts %}
			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
		{% endblock %}
	</body>
</html>
