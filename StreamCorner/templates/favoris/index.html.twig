{% extends 'base.html.twig' %}

{% block title %}StreamCorner | Favoris{% endblock %}
{% block body_class %}page-shell{% endblock %}
{% block body_data %}data-nav-icon="favoris"{% endblock %}

{% block body %}
  <main class="section">
    <div class="container stack-lg">
      <div class="split-header">
        <div>
          <div class="eyebrow eyebrow-bright">Ma sélection</div>
          <h1 class="section-title">Favoris_Produits</h1>
          <p class="muted">Retrouvez les produits que vous avez gardés de côté depuis la boutique.</p>
        </div>
        <a href="{{ path('app_catalogue') }}" class="btn btn-secondary">
          <span class="material-symbols-outlined">arrow_back</span>
          Retour boutique
        </a>
      </div>

      {% if produits|length == 0 %}
        <article class="catalog-empty-state panel">
          <div class="stack-md">
            <div class="pill">
              <span class="material-symbols-outlined">favorite</span>
              Liste vide
            </div>
            <h2 class="product-name">Aucun favori pour le moment</h2>
            <p class="muted">
              Ajoutez des produits depuis le catalogue avec l’icône cœur pour préparer une sélection avant achat.
            </p>
            <a href="{{ path('app_catalogue') }}" class="btn btn-primary">
              Découvrir les produits
              <span class="material-symbols-outlined">arrow_forward</span>
            </a>
          </div>
        </article>
      {% else %}
        <div class="product-grid catalog-grid" data-favorites-grid>
          {% for produit in produits %}
            {% set raw_image = produit.image %}
            {% set image_src = (raw_image starts with 'http' or raw_image starts with '/') ? raw_image : '/assets/images/products/' ~ raw_image %}
            {% set category_name = produit.categorie ? produit.categorie.nomCategorie : 'Matériel streaming' %}
            <article class="product-card" id="favori-{{ produit.id }}" data-favorites-item data-product-id="{{ produit.id }}">
              <a
                class="product-card-overlay"
                href="{{ path('app_produit_show', { id: produit.id }) }}"
                aria-label="Voir la fiche {{ produit.designation }}"
                tabindex="-1"
              ></a>
              <a
                class="product-favorite btn-icon is-active"
                href="{{ path('app_favoris', { id: produit.id }) }}"
                aria-label="Retirer des favoris"
                aria-pressed="true"
                data-favorite-toggle
                data-product-id="{{ produit.id }}"
              >
                <span class="material-symbols-outlined">favorite</span>
              </a>
              <div class="product-media">
                <img src="{{ image_src }}" alt="{{ produit.designation }}">
              </div>
              <div class="product-body">
                <div class="eyebrow eyebrow-bright">{{ category_name }}</div>
                <div class="product-meta">
                  <h2 class="product-name">{{ produit.designation }}</h2>
                  <div class="price-value">{{ produit.prixUnitHT }} EUR</div>
                </div>
                <p class="product-description">{{ produit.description|striptags|slice(0, 140) }}{% if produit.description|length > 140 %}...{% endif %}</p>
                <div class="product-card-actions">
                  <a class="btn btn-secondary" href="{{ path('app_produit_show', { id: produit.id }) }}">Voir la fiche</a>
                  {% if produit.stock > 0 %}
                    <a
                      class="btn btn-primary"
                      href="{{ path('app_panier_add', { id: produit.id }) }}"
                      data-cart-action
                      data-cart-action-type="add"
                      data-product-id="{{ produit.id }}"
                    >
                      <span class="material-symbols-outlined">add_shopping_cart</span>
                      <span data-cart-action-label>Ajouter</span>
                    </a>
                  {% else %}
                    <span class="btn btn-secondary is-disabled" aria-disabled="true">Rupture</span>
                  {% endif %}
                </div>
              </div>
            </article>
          {% endfor %}
        </div>

        <article class="catalog-empty-state panel" data-favorites-empty hidden>
          <div class="stack-md">
            <div class="pill">
              <span class="material-symbols-outlined">favorite</span>
              Liste vide
            </div>
            <h2 class="product-name">Aucun favori pour le moment</h2>
            <p class="muted">
              Ajoutez des produits depuis le catalogue avec l’icône cœur pour préparer une sélection avant achat.
            </p>
            <a href="{{ path('app_catalogue') }}" class="btn btn-primary">
              Découvrir les produits
              <span class="material-symbols-outlined">arrow_forward</span>
            </a>
          </div>
        </article>
      {% endif %}
    </div>
  </main>
{% endblock %}
