{% extends 'base.html.twig' %}

{% block title %}StreamCorner | Connexion{% endblock %}
{% block body_class %}compact-shell{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
  <main class="auth-page">
    <div class="container auth-layout">
      <section class="auth-brand stack-lg">
        <div class="stack-md">
          <div class="eyebrow eyebrow-bright">Connexion client</div>
          <h1>Stream<br>Corner</h1>
          <p>
            Retrouvez votre panier, vos commandes et vos informations de livraison en quelques secondes.
          </p>
        </div>

        <div class="stat-grid">
          <article class="stat-card panel">
            <div class="eyebrow">Vos achats</div>
            <h2 class="product-name">Suivi commande</h2>
          </article>
          <article class="stat-card panel">
            <div class="eyebrow">Votre panier</div>
            <h2 class="product-name">Articles conservés</h2>
          </article>
        </div>
      </section>

      <section class="auth-stack">
        <article class="auth-card glass-panel">
          <div class="stack-md">
            <div>
              <h2 class="product-name">Se connecter</h2>
              <p class="muted">Accédez à votre compte avec l'adresse email utilisée lors de votre inscription.</p>
            </div>

            {% if login_error %}
              <div class="requirements-panel glass-panel auth-feedback is-danger">
                <span class="material-symbols-outlined">error</span>
                <p class="muted">{{ login_error }}</p>
              </div>
            {% endif %}

            {% if app.user %}
              <div class="requirements-panel glass-panel">
                <p class="muted">
                  Vous êtes connecté avec {{ app.user.userIdentifier }}.
                  <a class="eyebrow eyebrow-bright" href="{{ path('app_logout') }}">Déconnexion</a>
                </p>
              </div>
            {% endif %}

            <form class="stack-md" method="post" novalidate>
              <div class="field">
                <label for="inputEmail">Email</label>
                <div class="input-icon">
                  <span class="material-symbols-outlined">alternate_email</span>
                  <input id="inputEmail" type="email" value="{{ last_username }}" name="email" autocomplete="email" placeholder="vous@email.fr" required autofocus>
                </div>
              </div>

              <div class="field">
                <label for="inputPassword">Mot de passe</label>
                <div class="input-icon">
                  <span class="material-symbols-outlined">lock</span>
                  <input id="inputPassword" type="password" name="password" autocomplete="current-password" placeholder="Mot de passe" required>
                </div>
              </div>

              <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
              <button class="btn btn-primary" type="submit">Se connecter</button>
            </form>

            <div class="auth-meta-line">
              <span class="muted">Pas encore inscrit ?</span>
              <a class="eyebrow eyebrow-bright" href="{{ path('app_register') }}">Créer un compte</a>
            </div>

            <div class="auth-meta-line">
              <span class="muted">Retour boutique</span>
              <a class="eyebrow eyebrow-bright" href="{{ path('app_accueil') }}">Accueil</a>
            </div>
          </div>
        </article>

        <article class="auth-card glass-panel">
          <div class="stack-md">
            <div class="auth-meta-line">
              <div>
                <div class="eyebrow eyebrow-bright">Votre espace</div>
                <h2 class="product-name">Compte client</h2>
              </div>
              <span class="material-symbols-outlined">account_circle</span>
            </div>

            <div class="auth-benefit-list">
              <div class="auth-benefit-row">
                <span class="material-symbols-outlined">receipt_long</span>
                <p>Consultez l'historique et l'état de vos commandes.</p>
              </div>
              <div class="auth-benefit-row">
                <span class="material-symbols-outlined">location_on</span>
                <p>Réutilisez vos adresses au moment du paiement.</p>
              </div>
              <div class="auth-benefit-row">
                <span class="material-symbols-outlined">favorite</span>
                <p>Gardez vos produits favoris pour plus tard.</p>
              </div>
            </div>

            <a class="btn btn-secondary" href="{{ path('app_catalogue') }}">
              <span class="material-symbols-outlined">storefront</span>
              Continuer mes achats
            </a>
          </div>
        </article>

        <div class="footer-copy">(c) 2026 StreamCorner. Tous droits réservés.</div>
      </section>
    </div>

    <div class="auth-watermark" aria-hidden="true">LOGIN</div>
  </main>
{% endblock %}
