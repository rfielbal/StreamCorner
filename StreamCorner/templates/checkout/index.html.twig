{% extends 'base.html.twig' %}

{% block title %}StreamCorner | Validation commande{% endblock %}
{% block body_class %}page-shell{% endblock %}
{% block body_data %}data-nav-icon="panier"{% endblock %}

{% block body %}
  <main class="section">
    <div class="container checkout-layout">
      <aside class="stack-md">
        <div>
          <h1 class="section-title">Résumé_Commande</h1>
          <p class="section-kicker">Validation du panier</p>
        </div>

        <div class="order-summary-panel panel">
          <div class="summary-items">
            {% for ligne in lignes %}
              {% set produit = ligne.produit %}
              {% set raw_image = produit ? produit.image : '' %}
              {% set image_src = (raw_image starts with 'http' or raw_image starts with '/') ? raw_image : '/assets/images/products/' ~ raw_image %}
              <article class="summary-item">
                {% if produit and raw_image %}
                  <img src="{{ image_src }}" alt="{{ produit.designation }}">
                {% endif %}
                <div class="stack-sm">
                  <div>
                    <h2 class="product-name">{{ produit ? produit.designation : 'Produit supprimé' }}</h2>
                    <div class="eyebrow eyebrow-bright">{{ ligne.prixHt|number_format(2, ',', ' ') }} € HT</div>
                  </div>
                  <div class="mini-row">
                    <span class="muted">Quantité : {{ ligne.quantite }}</span>
                    <strong>{{ (ligne.quantite * ligne.prixHt)|number_format(2, ',', ' ') }} €</strong>
                  </div>
                </div>
              </article>
            {% endfor %}
          </div>

          <div class="summary-total">
            <div class="row muted"><span>Total HT</span><span>{{ totalHt|number_format(2, ',', ' ') }} €</span></div>
            <div class="row muted"><span>TVA</span><span>{{ totalTaxe|number_format(2, ',', ' ') }} €</span></div>
            <div class="row">
              <span class="product-name">Total TTC</span>
              <span class="grand-total">{{ totalTtc|number_format(2, ',', ' ') }} €</span>
            </div>
          </div>
        </div>
      </aside>

      <section class="stack-lg">
        <div class="stepper">
          <div class="step is-active">
            <div class="step-bubble">1</div>
            <div class="step-label">Adresse</div>
          </div>
          <div class="step-line"></div>
          <div class="step is-active">
            <div class="step-bubble">2</div>
            <div class="step-label">Validation</div>
          </div>
        </div>

        {% include 'components/_flash_messages.html.twig' ignore missing %}

        {% include 'components/_form_panel.html.twig' with {
          form: form,
          title: 'Adresse_de_livraison',
          kicker: 'Commande',
          submit_label: 'Envoyer',
          back_path: path('app_panier')
        } %}
      </section>
    </div>
  </main>
{% endblock %}
