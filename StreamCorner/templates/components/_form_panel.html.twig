<article class="form-panel panel">
  <div class="stack-lg">
    <div>
      <div class="eyebrow eyebrow-bright">{{ kicker|default('Formulaire') }}</div>
      <h2 class="product-name">{{ title|default('Formulaire') }}</h2>
    </div>

    <div class="form-error-list">
      {{ form_errors(form) }}
    </div>

    {{ form_start(form, { attr: { class: 'stack-md' } }) }}
      <div class="field-grid">
        {% for child in form %}
          {% if child.vars.name != '_token' %}
            {% set is_wide = 'textarea' in child.vars.block_prefixes or child.vars.expanded %}
            <div class="field {{ is_wide ? 'full' : '' }}">
              {{ form_label(child) }}
              {{ form_widget(child) }}
              {{ form_help(child) }}
              {{ form_errors(child) }}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {{ form_rest(form) }}

      <div class="form-actions">
        {% if back_path is defined and back_path %}
          <a class="btn btn-ghost" href="{{ back_path }}">
            <span class="material-symbols-outlined">arrow_back</span>
            Retour
          </a>
        {% else %}
          <span></span>
        {% endif %}
        <button class="btn btn-primary" type="submit">
          {{ submit_label|default('Envoyer') }}
          <span class="material-symbols-outlined">send</span>
        </button>
      </div>
    {{ form_end(form) }}
  </div>
</article>
