{% set is_readonly = readonly|default(false) %}

<article class="form-panel panel {{ is_readonly ? 'is-readonly' : '' }}">
  <div class="stack-lg">
    <div>
      <div class="eyebrow eyebrow-bright">{{ kicker|default('Formulaire') }}</div>
      <h2 class="product-name">{{ title|default('Formulaire') }}</h2>
    </div>

    {% if is_readonly %}
      <div class="auth-feedback is-info glass-panel">
        <span class="material-symbols-outlined">visibility</span>
        <div>
          <strong>Mode visiteur</strong>
          <p>{{ readonly_message|default('Ce formulaire est consultable uniquement. Aucun ajout, modification ou suppression ne sera enregistré.') }}</p>
        </div>
      </div>
    {% endif %}

    <div class="form-error-list">
      {{ form_errors(form) }}
    </div>

    {{ form_start(form, { attr: { class: 'stack-md' } }) }}
      <fieldset class="readonly-fieldset" {{ is_readonly ? 'disabled' : '' }}>
        <div class="field-grid">
          {% for child in form %}
            {% if child.vars.name != '_token' %}
              {% set is_expanded = child.vars.expanded is defined and child.vars.expanded %}
              {% set is_wide = 'textarea' in child.vars.block_prefixes or is_expanded or child.vars.name in wide_fields|default([]) %}
              <div class="field {{ is_wide ? 'full' : '' }}">
                {{ form_row(child) }}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </fieldset>

      {{ form_rest(form) }}

      <div class="form-actions">
        {% if back_path is defined and back_path %}
          <a class="btn btn-ghost" href="{{ back_path }}">
            <span class="material-symbols-outlined">arrow_back</span>
            Retour
          </a>
        {% else %}
          <span></span>
        {% endif %}
        {% if is_readonly %}
          <span class="btn btn-secondary is-disabled" aria-disabled="true">
            Lecture seule
            <span class="material-symbols-outlined">lock</span>
          </span>
        {% else %}
          <button class="btn btn-primary" type="submit">
            {{ submit_label|default('Envoyer') }}
            <span class="material-symbols-outlined">send</span>
          </button>
        {% endif %}
      </div>
    {{ form_end(form) }}
  </div>
</article>
