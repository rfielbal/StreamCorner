            { id: 'command-center', category: 'Contrôle // Interface', name: 'Command Center', price: '149,99 EUR', image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuCCipA8MzyRpb0E57bDx9-cNnpkhXB4mzjjuUEM7XcUiho51DbG1Ntpu7NaVBb4aOZwrUplxi6Z_nZAfkV59tcDwQDc5h7x3kQZEBwhihtkfSz0QDSAfm2Za-JdOCzwkrfqxnuxRHyMmoBi_X5jS3DlOtWcrUvqoTLJ2U9rmiG8igV8ioCg9FgrPyGuJ5gUcleLZ8q2aQD3Zir-vJpw-tEkxwYqpdaP0rzG2JKXspnW8LTYrDIuxfRDMPBfIa4VcREl7AG9QfeW6i8' },
