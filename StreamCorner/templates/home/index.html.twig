          <a class="department-card span-4" href="{{ path('app_catalogue') }}#eclairage">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuC5e7DkhyDt-c5sEjAXgDOGQscSvOeFP9HjSJeOxW0n6fTtaArUhkKvth_FQvy2QYbs43klbbO1UrZ685hy-STN42i7hFUP_0PC7mNkbK5vVdvtBN9mNmgfktMcYKsSJSgnzEZdZiExp_aC8I663MI4lGhB9j9ifr3FIRs4RwgkuBsAwSwxvPSeubWPL8azdTq3U4lFzUDrHOf4BfXwW42lsdORj5d_WMbBUO3e-Udo_U6wRmhBWJXMAtkUC2imJfJcqXQr5VR0Dcg" alt="Éclairage studio">
            <div class="card-copy">
              <div class="eyebrow">Panneaux studio bicolores</div>
              <h3 class="product-name">Light_Flux</h3>
              <div class="eyebrow cta">Explorer la collection +</div>
            </div>
