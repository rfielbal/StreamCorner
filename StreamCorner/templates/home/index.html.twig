{% extends 'base.html.twig' %}

{% block title %}StreamCorner | Accueil{% endblock %}
{% block body_class %}page-shell home-page{% endblock %}
{% block body_data %}data-nav-section="accueil"{% endblock %}

{% block body %}
  <main>
    <section class="home-hero">
      <div class="home-hero-media" aria-hidden="true">
        <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBg77Bl2DL_u4REoXqCrvleLcq8UP2qr2ERO-AiwWcTq4NVPxFmj1emdT-35bOmlsWsmKUp7vxEwDcyVVaHvJpOZyXpY6cJW_KYVJ2wEV80oyP9ccI-ceWO9Xo35RqverQAmbaUCqkN8zA0lm26Apv4Qu3QTHBUMEmomAas4A8mbzUg9R2iih0s_O6V3hPai1vfBM2ZrXl6psbv0Bbw4wzSxMTKeqDM0agsvdr5HWmZn4yl7XWmUIlBklwKGRNBVfTZMjC4HDV1-IE" alt="">
      </div>

      <div class="container">
        <div class="home-hero-stage">
          <div class="home-hero-content">
            <span class="hero-pill">SYSTÈME_INITIÉ // 2026</span>
            <h1 class="home-hero-title">
              LE <span class="accent">NEXUS</span><br>
              STREAM DECK
            </h1>
            <p class="home-hero-text">
              Contrôle tactile total. Retour visuel instantané. Précision conçue pour les créateurs et streamers exigeants.
            </p>
            <div class="home-hero-actions">
              <a class="btn btn-primary" href="{{ path('app_produit_demo', { product: 'command-center' }) }}">
                Configurer maintenant
                <span class="material-symbols-outlined">arrow_forward</span>
              </a>
              <a class="btn btn-secondary" href="{{ path('app_catalogue') }}">Voir le catalogue</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="setup-dream-section" aria-labelledby="setup-dream-title">
      <div class="container">
        <div class="split-header setup-dream-header">
          <div>
            <div class="eyebrow eyebrow-bright">Carte interactive</div>
            <h2 class="section-title setup-dream-heading" id="setup-dream-title">Réalisez le Setup de vos rêves</h2>
          </div>
          <p class="setup-dream-copy">Survolez un repère pour ouvrir la fiche produit associée.</p>
        </div>
      </div>

      <div class="setup-dream-breakout">
        <div class="setup-dream-card">
          <div class="setup-dream-scene">
            <img src="/assets/images/setup-dream-base.png" alt="Setup de streaming interactif avec plusieurs produits repérés">

            {% set hotspots = [
              {
                x: '14.1%', y: '43.8%', line_left: '0.95rem', line_top: '2.35rem', line_width: '8.6rem', line_height: '4.8rem', label_left: '3.65rem', label_top: '0.35rem', label_width: '10rem', line_class: 'setup-dream-line--right-down', slug: 'command-center', label: 'Command Center'
              },
              {
                x: '55.2%', y: '18.6%', line_left: '-5.9rem', line_top: '0.9rem', line_width: '5.1rem', line_height: '4.2rem', label_left: '-0.45rem', label_top: '2.9rem', label_width: '10rem', line_class: 'setup-dream-line--left-down', slug: 'obsidian-stream-webcam', label: 'Obsidian Webcam'
              },
              {
                x: '85.6%', y: '20.8%', line_left: '-6.3rem', line_top: '2.2rem', line_width: '5.6rem', line_height: '4rem', label_left: '-10.8rem', label_top: '0.35rem', label_width: '9rem', line_class: 'setup-dream-line--left-down', slug: 'aether-pro-led-panels', label: 'Aether LED Panels'
              },
              {
                x: '51%', y: '57.8%', line_left: '-5.7rem', line_top: '-3.35rem', line_width: '4.8rem', line_height: '3.4rem', label_left: '-10.45rem', label_top: '-0.2rem', label_width: '9rem', line_class: 'setup-dream-line--left-up', slug: 'vector-boom-arm', label: 'Vector Boom Arm'
              },
              {
                x: '65%', y: '63.7%', line_left: '-7.6rem', line_top: '1.15rem', line_width: '6.5rem', line_height: '0.85rem', label_left: '3.65rem', label_top: '0.55rem', label_width: '7rem', line_class: 'setup-dream-line--left-flat', slug: 'pulse-mic', label: 'Pulse Mic'
              },
              {
                x: '88.5%', y: '73.8%', line_left: '-7.2rem', line_top: '1.5rem', line_width: '6rem', line_height: '0.85rem', label_left: '-8.95rem', label_top: '0.5rem', label_width: '7rem', line_class: 'setup-dream-line--left-flat', slug: 'vox-monitor-speaker', label: 'Vox Speaker'
              },
              {
                x: '28.8%', y: '79%', line_left: '1.1rem', line_top: '-3.05rem', line_width: '6.4rem', line_height: '3.1rem', label_left: '3.7rem', label_top: '-2.2rem', label_width: '7rem', line_class: 'setup-dream-line--right-up', slug: 'kraken-tkl-mechanical-keyboard', label: 'Kraken TKL'
              }
            ] %}

            {% for hotspot in hotspots %}
              <div
                class="setup-dream-hotspot"
                style="--x: {{ hotspot.x }}; --y: {{ hotspot.y }}; --line-left: {{ hotspot.line_left }}; --line-top: {{ hotspot.line_top }}; --line-width: {{ hotspot.line_width }}; --line-height: {{ hotspot.line_height }}; --label-left: {{ hotspot.label_left }}; --label-top: {{ hotspot.label_top }}; --label-width: {{ hotspot.label_width }};"
              >
                <span class="setup-dream-line {{ hotspot.line_class }}" aria-hidden="true"></span>
                <a class="setup-dream-trigger" href="{{ path('app_produit_demo', { product: hotspot.slug }) }}" aria-label="Voir la fiche produit {{ hotspot.label }}">
                  <img src="/assets/images/setup-dream-hotspot.png" alt="" aria-hidden="true">
                  <span class="sr-only">{{ hotspot.label }}</span>
                </a>
                <span class="setup-dream-title">{{ hotspot.label }}</span>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

