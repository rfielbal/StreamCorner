{% extends 'base.html.twig' %}

{% block title %}StreamCorner | Accueil{% endblock %}
{% block body_class %}page-shell home-page{% endblock %}
{% block body_data %}data-nav-section="accueil"{% endblock %}

{% block body %}
  <main>
    <section class="home-hero">
      <div class="home-hero-media" aria-hidden="true">
        <img src="/assets/images/hero-section.png" alt="">
      </div>

      <div class="container">
        <div class="home-hero-stage">
          <div class="home-hero-content">
            <span class="hero-pill">SYSTÈME_INITIÉ // 2026</span>
            <h1 class="home-hero-title">
              LE <span class="accent">NEXUS</span><br>
              STREAM DECK
            </h1>
            <p class="home-hero-text">
              Contrôle tactile total. Retour visuel instantané. Précision conçue pour les créateurs et streamers exigeants.
            </p>
            <div class="home-hero-actions">
              <a class="btn btn-primary" href="{{ path('app_resultat', { q: 'Command Center' }) }}">
                Configurer maintenant
                <span class="material-symbols-outlined">arrow_forward</span>
              </a>
              <a class="btn btn-secondary" href="{{ path('app_catalogue') }}">Voir le catalogue</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="setup-dream-section" aria-labelledby="setup-dream-title">
      <div class="container">
        <div class="split-header setup-dream-header">
          <div>
            <div class="eyebrow eyebrow-bright">Carte interactive</div>
            <h2 class="section-title setup-dream-heading" id="setup-dream-title">Réalisez le Setup de vos rêves</h2>
          </div>
          <p class="setup-dream-copy">Survolez un repère pour ouvrir la fiche produit associée.</p>
        </div>
      </div>

      <div class="setup-dream-breakout">
        <div class="setup-dream-card">
          <div class="setup-dream-scene">
            <img src="/assets/images/setup-dream-base.png" alt="Setup de streaming interactif avec plusieurs produits repérés">

            {% set hotspots = [
              {
                x: '14.1%', y: '43.8%', line_left: '0.95rem', line_top: '2.35rem', line_width: '8.6rem', line_height: '4.8rem', label_left: '3.65rem', label_top: '0.35rem', label_width: '10rem', line_class: 'setup-dream-line--right-down', slug: 'command-center', label: 'Command Center'
              },
              {
                x: '55.2%', y: '18.6%', line_left: '-5.9rem', line_top: '0.9rem', line_width: '5.1rem', line_height: '4.2rem', label_left: '-0.45rem', label_top: '2.9rem', label_width: '10rem', line_class: 'setup-dream-line--left-down', slug: 'obsidian-stream-webcam', label: 'Obsidian Webcam'
              },
              {
                x: '85.6%', y: '20.8%', line_left: '-6.3rem', line_top: '2.2rem', line_width: '5.6rem', line_height: '4rem', label_left: '-10.8rem', label_top: '0.35rem', label_width: '9rem', line_class: 'setup-dream-line--left-down', slug: 'aether-pro-led-panels', label: 'Aether LED Panels'
              },
              {
                x: '51%', y: '57.8%', line_left: '-5.7rem', line_top: '-3.35rem', line_width: '4.8rem', line_height: '3.4rem', label_left: '-10.45rem', label_top: '-0.2rem', label_width: '9rem', line_class: 'setup-dream-line--left-up', slug: 'vector-boom-arm', label: 'Vector Boom Arm'
              },
              {
                x: '65%', y: '63.7%', line_left: '-7.6rem', line_top: '1.15rem', line_width: '6.5rem', line_height: '0.85rem', label_left: '3.65rem', label_top: '0.55rem', label_width: '7rem', line_class: 'setup-dream-line--left-flat', slug: 'pulse-mic', label: 'Pulse Mic'
              },
              {
                x: '88.5%', y: '73.8%', line_left: '-7.2rem', line_top: '1.5rem', line_width: '6rem', line_height: '0.85rem', label_left: '-8.95rem', label_top: '0.5rem', label_width: '7rem', line_class: 'setup-dream-line--left-flat', slug: 'vox-monitor-speaker', label: 'Vox Speaker'
              },
              {
                x: '28.8%', y: '79%', line_left: '1.1rem', line_top: '-3.05rem', line_width: '6.4rem', line_height: '3.1rem', label_left: '3.7rem', label_top: '-2.2rem', label_width: '7rem', line_class: 'setup-dream-line--right-up', slug: 'kraken-tkl-mechanical-keyboard', label: 'Kraken TKL'
              }
            ] %}

            {% for hotspot in hotspots %}
              <div
                class="setup-dream-hotspot"
                style="--x: {{ hotspot.x }}; --y: {{ hotspot.y }}; --line-left: {{ hotspot.line_left }}; --line-top: {{ hotspot.line_top }}; --line-width: {{ hotspot.line_width }}; --line-height: {{ hotspot.line_height }}; --label-left: {{ hotspot.label_left }}; --label-top: {{ hotspot.label_top }}; --label-width: {{ hotspot.label_width }};"
              >
                <span class="setup-dream-line {{ hotspot.line_class }}" aria-hidden="true"></span>
                <a class="setup-dream-trigger" href="{{ path('app_resultat', { q: hotspot.label }) }}" aria-label="Voir la fiche produit {{ hotspot.label }}">
                  <img src="/assets/images/setup-dream-hotspot.png" alt="" aria-hidden="true">
                  <span class="sr-only">{{ hotspot.label }}</span>
                </a>
                <span class="setup-dream-title">{{ hotspot.label }}</span>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="container">
        <div class="split-header">
          <div>
            <h2 class="section-title">DÉPARTEMENTS_SYSTÈME</h2>
            <p class="home-section-subtitle">Sélectionnez votre niveau d'équipement</p>
          </div>
        </div>

        <div class="grid-cards department-grid">
          <a class="department-card span-8" href="{{ path('app_catalogue') }}#audio">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuCONKbZG9oo0BSgbp8nqZJhsReamLO5La0No6J2GTDcuOFmwTlxZ-QVH_h_ytdj6h96Cjwe7D8MUdZir1dYK5gXNaPE9NtnfyysegiIlz2rgZVyyGWSwImVmyyqT4DMNX4gW5G4-0GORzXDzidQz0hQ1zm6AutezqGb7Ts_oOEhzEQinrW0hCucLbYLkA9ycA-FlGvCAh7wgOa2apLU6kyOeI2vimGsjkiZPLFuyAfaSPOMAHkkPnP5q2nCPbu7c0IYlb3jjuyN66Y" alt="Matériel audio">
            <div class="card-copy">
              <div class="eyebrow">Surveillance sans latence</div>
              <h3 class="product-name">Audio_Core</h3>
              <div class="eyebrow cta">Explorer la collection +</div>
            </div>
          </a>

          <a class="department-card span-4" href="{{ path('app_catalogue') }}#eclairage">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuC5e7DkhyDt-c5sEjAXgDOGQscSvOeFP9HjSJeOxW0n6fTtaArUhkKvth_FQvy2QYbs43klbbO1UrZ685hy-STN42i7hFUP_0PC7mNkbK5vVdvtBN9mNmgfktMcYKsSJSgnzEZdZiExp_aC8I663MI4lGhB9j9ifr3FIRs4RwgkuBsAwSwxvPSeubWPL8azdTq3U4lFzUDrHOf4BfXwW42lsdORj5d_WMbBUO3e-Udo_U6wRmhBWJXMAtkUC2imJfJcqXQr5VR0Dcg" alt="Éclairage studio">
            <div class="card-copy">
              <div class="eyebrow">Panneaux studio bicolores</div>
              <h3 class="product-name">Light_Flux</h3>
              <div class="eyebrow cta">Explorer la collection +</div>
            </div>
          </a>

          <a class="department-card span-4" href="{{ path('app_catalogue') }}">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuCAuXteNOZfKsnGZzc82zTDAiCbp6Cpw73hOan_9vKpiSKVy58urQA05cBqzzqXEU1nTo-EXDn_gRmf6YxcQ2aUAzjhAMZR9hz4tjUNITJkX_gKu9JRV7UGD7bskms0f87fwBMm9X_YWCAYYrtItq2D4kGR8aWx0W_rDGORGOMMEzQO2qFskJaqNyhr4UeBoe520mc7JdhL1gRk8erbBmHR2Pv0in3J8zGnXBJ0m-BuRxSBVPFtyBAcTrMCubgg2ycw7WZmJqyT0ow" alt="Contrôle streaming">
            <div class="card-copy">
              <div class="eyebrow">Exécution de macros</div>
              <h3 class="product-name">Synapse_Control</h3>
              <div class="eyebrow cta">Explorer la collection +</div>
            </div>
          </a>

          <a class="department-card span-8" href="{{ path('app_catalogue') }}">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuDYD9fChum7oAqJDO2-wzHNKuBlW1mHUoUL-wPZa4EGho4puibd1RhSxv0aZO1l7GkfCllBWWK0vJrmhBxMQsIanmAlgjeyQXYdERj4h6C8PeNBr0w5EYQxwcxt_z2PfJIooHfQXBIiquJCYdfqZ0IhksN1qz3W0RUO6_ktASM8z1sGwaDIee_dlpNEd347hhm9WtZJus_jDqTd7_H1o-vgwk1oYDHToGMNpT8Cw1oVuPYWvQDRw9cjAI-0_cFjV_Bd_I9WI8EN9JM" alt="Capture vidéo">
            <div class="card-copy">
              <div class="eyebrow">Capture 4K60 pro</div>
              <h3 class="product-name">Capture_Frame</h3>
              <div class="eyebrow cta">Explorer la collection +</div>
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="home-products">
      <div class="container">
        <div class="split-header">
          <div>
            <h2 class="section-title">Essentiels_Diffusion</h2>
            <p class="muted">Une sélection compatible avec le modèle Symfony `Produit`.</p>
          </div>
        </div>

        <div class="product-grid">
          {% for item in featuredProducts|default([]) %}
            {% set raw_image = item.image %}
            {% set image_src = (raw_image starts with 'http' or raw_image starts with '/') ? raw_image : '/assets/images/products/' ~ raw_image %}
            <article class="product-card">
              <div class="product-media">
                <img src="{{ image_src }}" alt="{{ item.designation }}">
              </div>
              <div class="product-body">
                <div class="home-product-meta">
                  <div class="eyebrow eyebrow-bright">{{ item.categorie ? item.categorie.nomCategorie : 'Catalogue' }}</div>
                  <h3 class="product-name">{{ item.designation }}</h3>
                </div>
                <div class="home-product-footer">
                  <span class="home-product-price">{{ item.prixUnitHT }} EUR</span>
                  <a class="home-product-cart btn-icon" href="{{ path('app_produit_show', { id: item.id }) }}" aria-label="Voir le produit {{ item.designation }}">
                    <span class="material-symbols-outlined">arrow_forward</span>
                  </a>
                </div>
              </div>
            </article>
          {% else %}
            <article class="catalog-empty-state panel">
              <div class="stack-md">
                <div class="eyebrow eyebrow-bright">Catalogue Doctrine</div>
                <h3 class="product-name">Aucun produit publié</h3>
                <p class="muted">Les produits ajoutés en administration apparaîtront ici automatiquement.</p>
                <a class="btn btn-secondary" href="{{ path('app_catalogue') }}">Ouvrir le catalogue</a>
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="section newsletter">
      <div class="container">
        <div class="newsletter-panel">
          <h2 class="section-title">Contacter_<em>StreamCorner</em></h2>
          <p class="muted">Une question sur un produit, une commande ou un setup streaming ? Envoyez un message au support.</p>
          <div class="newsletter-form">
            <a class="btn btn-primary" href="{{ path('app_contact') }}">
              Ouvrir le formulaire
              <span class="material-symbols-outlined">arrow_forward</span>
            </a>
          </div>
          <div class="newsletter-note">Messages stockés en base // Consultation administration</div>
        </div>
      </div>
    </section>
  </main>
{% endblock %}
