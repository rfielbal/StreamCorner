          <a class="department-card span-4" href="{{ path('app_catalogue') }}">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuCAuXteNOZfKsnGZzc82zTDAiCbp6Cpw73hOan_9vKpiSKVy58urQA05cBqzzqXEU1nTo-EXDn_gRmf6YxcQ2aUAzjhAMZR9hz4tjUNITJkX_gKu9JRV7UGD7bskms0f87fwBMm9X_YWCAYYrtItq2D4kGR8aWx0W_rDGORGOMMEzQO2qFskJaqNyhr4UeBoe520mc7JdhL1gRk8erbBmHR2Pv0in3J8zGnXBJ0m-BuRxSBVPFtyBAcTrMCubgg2ycw7WZmJqyT0ow" alt="Contrôle streaming">
            <div class="card-copy">
