          {% for item in products %}
            <article class="product-card">
              <div class="product-media">
                <img src="{{ item.image }}" alt="{{ item.name }}">
              </div>
              <div class="product-body">
                <div class="home-product-meta">
                  <div class="eyebrow eyebrow-bright">{{ item.category }}</div>
                  <h3 class="product-name">{{ item.name }}</h3>
                </div>
                <div class="home-product-footer">
                  <span class="home-product-price">{{ item.price }}</span>
                  <a class="home-product-cart btn-icon" href="{{ path('app_produit_demo', { product: item.id }) }}" aria-label="Voir le produit {{ item.name }}">
