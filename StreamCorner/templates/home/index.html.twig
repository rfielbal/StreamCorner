{% extends 'base.html.twig' %}

{% block title %}StreamCorner | Accueil{% endblock %}
{% block body_class %}page-shell home-page{% endblock %}
{% block body_data %}data-nav-section="accueil"{% endblock %}

{% block body %}
  {% set nexusProduct = setupProducts['Nexus Stream Deck']|default(null) %}

  <main>
    <section class="home-hero">
      <div class="home-hero-media" aria-hidden="true">
        <img src="/assets/images/hero-section.png" alt="">
      </div>

      <div class="container">
        <div class="home-hero-stage">
          <div class="home-hero-content">
            <span class="hero-pill">SYSTÈME_INITIÉ // 2026</span>
            <h1 class="home-hero-title">
              LE <span class="accent">NEXUS</span><br>
              STREAM DECK
            </h1>
            <p class="home-hero-text">
              Contrôle tactile total. Retour visuel instantané. Précision conçue pour les créateurs et streamers exigeants.
            </p>
            <div class="home-hero-actions">
              <a class="btn btn-primary" href="{{ nexusProduct ? path('app_produit_show', { id: nexusProduct.id }) : path('app_resultat', { q: 'Nexus Stream Deck' }) }}">
                Découvrez-le maintenant
                <span class="material-symbols-outlined">arrow_forward</span>
              </a>
              <a class="btn btn-secondary" href="{{ path('app_catalogue') }}">Voir le catalogue</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="setup-dream-section" aria-labelledby="setup-dream-title">
      <div class="container">
        <div class="split-header setup-dream-header">
          <div>
            <div class="eyebrow eyebrow-bright">Carte interactive</div>
            <h2 class="section-title setup-dream-heading" id="setup-dream-title">Réalisez le Setup de vos rêves</h2>
          </div>
          <p class="setup-dream-copy">Survolez une main pour afficher le produit, cliquez pour ouvrir sa fiche.</p>
        </div>
      </div>

      <div class="setup-dream-breakout">
        <div class="setup-dream-card">
          <div class="setup-dream-scene">
            <img src="/assets/images/design.png" alt="Setup de streaming interactif avec plusieurs produits repérés">

            {% set hotspots = [
              {
                x: '10%', y: '62.5%', label_left: '1.95rem', label_top: '-2.25rem', label_width: '10rem', product: 'Nexus Stream Deck', label: 'Nexus Stream Deck'
              },
              {
                x: '54.6%', y: '15.8%', label_left: '1.8rem', label_top: '-0.7rem', label_width: '10rem', product: 'Obsidian Webcam', label: 'Obsidian Webcam'
              },
              {
                x: '85.7%', y: '18.2%', label_left: '-11.4rem', label_top: '-0.7rem', label_width: '10.2rem', product: 'Aether Pro LED Panels', label: 'Aether Pro LED Panels'
              },
              {
                x: '63.4%', y: '57.2%', label_left: '-8.8rem', label_top: '-0.85rem', label_width: '7.5rem', product: 'Pulse MIC', label: 'Pulse MIC'
              },
              {
                x: '89.5%', y: '70.9%', label_left: '-10.95rem', label_top: '-0.75rem', label_width: '9.6rem', product: 'Vox Monitor Speaker', label: 'Vox Monitor Speaker'
              },
              {
                x: '36.9%', y: '82.5%', label_left: '1.95rem', label_top: '-1rem', label_width: '9.6rem', product: 'Cobalt Stream Deck', label: 'Cobalt Stream Deck'
              }
            ] %}

            {% for hotspot in hotspots %}
              {% set setupProduct = setupProducts[hotspot.product]|default(null) %}
              <a
                class="setup-dream-hotspot"
                style="--x: {{ hotspot.x }}; --y: {{ hotspot.y }}; --label-left: {{ hotspot.label_left }}; --label-top: {{ hotspot.label_top }}; --label-width: {{ hotspot.label_width }};"
                href="{{ setupProduct ? path('app_produit_show', { id: setupProduct.id }) : path('app_resultat', { q: hotspot.product }) }}"
                aria-label="Voir la fiche produit {{ hotspot.product }}"
              >
                <span class="setup-dream-trigger" aria-hidden="true"></span>
                <span class="setup-dream-title">{{ hotspot.label }}</span>
              </a>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="container">
        <div class="split-header">
          <div>
            <h2 class="section-title">Univers_Streaming</h2>
            <p class="home-section-subtitle">Capture, support et monitoring issus du catalogue</p>
          </div>
        </div>

        {% set universeCards = [
          {
            product: universeProducts['Vector Boom Arm']|default(null),
            eyebrow: 'Accessoires',
            category_slug: 'accessoires',
            title: 'Support micro',
            copy: 'Un bras articulé pour placer le micro au bon angle, libérer le bureau et garder une voix stable pendant les sessions longues.'
          },
          {
            product: universeProducts['Hyper Capture Card 4K']|default(null),
            eyebrow: 'Diffusion',
            category_slug: 'diffusion',
            title: 'Capture 4K',
            copy: 'Une carte de capture dédiée pour connecter console, caméra ou second PC avec une image nette et un flux plus propre.'
          },
          {
            product: universeProducts['All-In Monitor Audio']|default(null),
            eyebrow: 'Controle',
            category_slug: 'controle',
            title: 'Station de monitoring',
            copy: 'Un écran de contrôle audio pour suivre vos sources, ajuster votre retour et garder les alertes lisibles au même endroit.'
          }
        ] %}

        <div class="universe-product-grid">
          {% for card in universeCards %}
            {% if card.product %}
              {% set raw_image = card.product.image %}
              {% set image_src = (raw_image starts with 'http' or raw_image starts with '/') ? raw_image : '/assets/images/products/' ~ raw_image %}
              <article class="universe-product-card">
                <a class="universe-product-media" href="{{ path('app_produit_show', { id: card.product.id }) }}" aria-label="Voir la fiche {{ card.product.designation }}">
                  <img src="{{ image_src }}" alt="{{ card.product.designation }}">
                </a>
                <div class="universe-product-body">
                  <div>
                    <div class="eyebrow eyebrow-bright">{{ card.eyebrow }}</div>
                    <h3 class="product-name">{{ card.product.designation }}</h3>
                    <p class="universe-product-role">{{ card.title }}</p>
                  </div>
                  <p class="universe-product-copy">{{ card.copy }}</p>
                  <div class="universe-product-meta">
                    <span class="home-product-price">{{ card.product.prixUnitHT }} EUR</span>
                    <span class="meta-text">{{ card.product.stock > 0 ? card.product.stock ~ ' en stock' : 'Rupture' }}</span>
                  </div>
                  <div class="universe-product-actions">
                    <a class="btn btn-primary" href="{{ path('app_produit_show', { id: card.product.id }) }}">
                      Voir la fiche
                      <span class="material-symbols-outlined">arrow_forward</span>
                    </a>
                    <a class="universe-category-link" href="{{ path('app_catalogue', { categorie: card.category_slug }) }}">Voir la catégorie</a>
                  </div>
                </div>
              </article>
            {% endif %}
          {% else %}
            <article class="catalog-empty-state panel">
              <div class="stack-md">
                <div class="eyebrow eyebrow-bright">Catalogue</div>
                <h3 class="product-name">Produits bientôt disponibles</h3>
                <p class="muted">Les produits complémentaires ajoutés en administration apparaîtront ici.</p>
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="home-products">
      <div class="container">
        <div class="split-header">
          <div>
            <h2 class="section-title">Produits_à_la_une</h2>
            <p class="muted">Découvrez une sélection d'équipements pensés pour améliorer votre setup streaming.</p>
          </div>
        </div>

        <div class="product-grid">
          {% for item in featuredProducts|default([]) %}
            {% set raw_image = item.image %}
            {% set image_src = (raw_image starts with 'http' or raw_image starts with '/') ? raw_image : '/assets/images/products/' ~ raw_image %}
            <article class="product-card">
              <a
                class="product-card-overlay"
                href="{{ path('app_produit_show', { id: item.id }) }}"
                aria-label="Voir la fiche {{ item.designation }}"
                tabindex="-1"
              ></a>
              <div class="product-media">
                <img src="{{ image_src }}" alt="{{ item.designation }}">
              </div>
              <div class="product-body">
                <div class="home-product-meta">
                  <div class="eyebrow eyebrow-bright">{{ item.categorie ? item.categorie.nomCategorie : 'Catalogue' }}</div>
                  <h3 class="product-name">{{ item.designation }}</h3>
                </div>
                <div class="home-product-footer">
                  <span class="home-product-price">{{ item.prixUnitHT }} EUR</span>
                  <a class="home-product-cart btn-icon" href="{{ path('app_produit_show', { id: item.id }) }}" aria-label="Voir le produit {{ item.designation }}">
                    <span class="material-symbols-outlined">arrow_forward</span>
                  </a>
                </div>
              </div>
            </article>
          {% else %}
            <article class="catalog-empty-state panel">
              <div class="stack-md">
                <div class="eyebrow eyebrow-bright">Catalogue Doctrine</div>
                <h3 class="product-name">Aucun produit publié</h3>
                <p class="muted">Les produits ajoutés en administration apparaîtront ici automatiquement.</p>
                <a class="btn btn-secondary" href="{{ path('app_catalogue') }}">Ouvrir le catalogue</a>
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="section newsletter">
      <div class="container">
        <div class="newsletter-panel">
          <h2 class="section-title">Contacter_<em>StreamCorner</em></h2>
          <p class="muted">Une question sur un produit, une commande ou un setup streaming ? Envoyez un message au support.</p>
          <div class="newsletter-form">
            <a class="btn btn-primary" href="{{ path('app_contact') }}">
              Nous contacter
              <span class="material-symbols-outlined">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
{% endblock %}
