{% extends 'base.html.twig' %}

{% set is_demo = demo_mode|default(false) %}
{% set product_name = produit ? produit.designation : 'Command Center' %}
{% set product_price = produit ? produit.prixUnitHT ~ ' EUR' : '149,99 EUR' %}
{% set product_description = produit ? produit.description : "Console de pilotage compacte pour lancer vos scènes, overlays et macros sans quitter l'écran principal. Une vraie tour de contrôle pour le setup." %}
{% set product_category = produit and produit.categorie ? produit.categorie.nomCategorie : 'Console modulaire' %}
{% set product_gallery = produit ? produit.images : [] %}
{% set primary_gallery_image = product_gallery|length > 0 ? product_gallery|first : null %}
{% set raw_image = primary_gallery_image ? primary_gallery_image.filename : (produit ? produit.image : 'https://lh3.googleusercontent.com/aida-public/AB6AXuDZUd-zzhzhAwqcvVN5x5xiWvonJvYqPAkq0-VDcd0aCS63A6R_t0PQvISa5_NAig1uME07IzXOJNXHelnRUs_By0otGuKb2EDXVChqpX070n8cok3eul7x_uOw21uugQsspPJR7uEh6Hhpa8xlsb5KsaQuYscb0Mrb8O3jSOZ1z5NBLFbau_3-tOJMW7dqXyMJakzEzgkWA5ibVFFJsCbsGa6Snfh9fcAgohgQ46LdAZjQRDeLDsYPOsE5UzHblvRIbyt0SelZa2s') %}
{% set product_image = (raw_image starts with 'http' or raw_image starts with '/') ? raw_image : '/assets/images/products/' ~ raw_image %}
{% set cart_path = produit ? path('app_panier_add', { id: produit.id }) : path('app_catalogue') %}
{% set favorite_path = produit ? path('app_favoris', { id: produit.id }) : path('app_login') %}

{% block title %}StreamCorner | {{ product_name }}{% endblock %}
{% block body_class %}page-shell product-page{% endblock %}
{% block body_data %}data-nav-section="boutique"{% if is_demo %} data-product-page="true"{% endif %}{% endblock %}

{% block body %}
  <main class="section">
    <div class="container stack-lg">
      <div class="product-layout">
        <section>
          <div class="gallery-main">
            <img data-gallery-main src="{{ product_image }}" alt="{{ product_name }}">
          </div>

          <div class="gallery-thumbs">
            {% if product_gallery|length > 0 %}
              {% for image in product_gallery %}
                {% set gallery_src = (image.filename starts with 'http' or image.filename starts with '/') ? image.filename : '/assets/images/products/' ~ image.filename %}
                <button
                  class="gallery-thumb {{ loop.first ? 'is-active' : '' }}"
                  type="button"
                  data-gallery-thumb
                  data-product-gallery-slot="{{ loop.index0 }}"
                  data-gallery-src="{{ gallery_src }}"
                  data-gallery-alt="{{ image.alt ?: product_name }}"
                  aria-label="{{ image.alt ?: product_name }}"
                >
                  <img src="{{ gallery_src }}" alt="{{ image.alt ?: product_name }}">
                </button>
              {% endfor %}
            {% else %}
              <button
                class="gallery-thumb is-active"
                type="button"
                data-gallery-thumb
                data-product-gallery-slot="0"
                data-gallery-src="{{ product_image }}"
                data-gallery-alt="{{ product_name }}"
                aria-label="{{ product_name }}"
              >
                <img src="{{ product_image }}" alt="{{ product_name }}">
              </button>
            {% endif %}
          </div>
        </section>

        <aside class="product-summary">
          <div class="summary-panel panel">
            <div class="stack-md">
              <div class="pill" data-product-pill>{{ product_category }}</div>
              <h1 class="section-title" data-product-title>{{ product_name }}</h1>
              <p class="summary-copy" data-product-summary>{{ product_description }}</p>

              <div class="stock-note">
                <span data-product-stock-text>{{ produit and produit.stock <= 0 ? 'Rupture' : 'En stock' }}</span>
                <span class="eyebrow eyebrow-bright" data-product-stock-meta>{{ produit ? produit.stock ~ ' unité(s)' : 'Livraison 48h' }}</span>
              </div>

              <div class="price-row">
                <span class="price-value" data-product-price>{{ product_price }}</span>
                <span class="meta-text" data-product-price-note>Prix net</span>
              </div>

              <div class="summary-actions">
                <a class="btn btn-primary {{ produit and produit.stock <= 0 ? 'is-disabled' : '' }}" href="{{ cart_path }}" data-product-buy aria-disabled="{{ produit and produit.stock <= 0 ? 'true' : 'false' }}">
                  <span class="material-symbols-outlined">shopping_cart</span>
                  {{ produit and produit.stock <= 0 ? 'Rupture' : 'Ajouter au panier' }}
                </a>
                <a class="btn btn-secondary" href="{{ favorite_path }}" data-product-favorite>
                  <span class="material-symbols-outlined">favorite</span>
                  Ajouter aux favoris
                </a>
              </div>
            </div>

            <div class="summary-specs">
              <div>
                <strong data-product-summary-spec-label="0">Catégorie</strong>
                <span data-product-summary-spec-value="0">{{ product_category }}</span>
              </div>
              <div>
                <strong data-product-summary-spec-label="1">Stock</strong>
                <span data-product-summary-spec-value="1">{{ produit ? produit.stock ~ ' unité(s)' : 'Disponible' }}</span>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <section class="feature-band">
      <div class="container feature-band-grid">
        <div class="stack-md">
          <div class="eyebrow eyebrow-bright" data-product-feature-eyebrow">Actions multiples</div>
          <h2 class="section-title" data-product-feature-title>Une fiche, <em>contrôle total</em></h2>
          <p class="muted" data-product-feature-text">
            Cette fiche affiche les données Doctrine du produit, sa galerie complète, son stock et ses actions panier/favoris.
          </p>
          <div class="stack-sm">
            <div class="mini-stat">
              <span data-product-feature-stat-text="0">Données produit branchées sur Symfony</span>
              <span class="material-symbols-outlined" data-product-feature-stat-icon="0">database</span>
            </div>
            <div class="mini-stat">
              <span data-product-feature-stat-text="1">Galerie alimentée par les uploads admin</span>
              <span class="material-symbols-outlined" data-product-feature-stat-icon="1">photo_library</span>
            </div>
          </div>
        </div>
        <div class="feature-visual">
          <img data-product-feature-image src="{{ product_image }}" alt="{{ product_name }}">
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container stack-lg">
        <div class="split-header">
          <div>
            <h2 class="section-title">Spécifications_<em>Système</em></h2>
            <p class="muted" data-product-specs-intro">Informations enregistrées depuis le formulaire d'administration.</p>
          </div>
          <div class="meta-text" data-product-protocol>Référence produit : {{ produit ? produit.id : 'DEMO' }}</div>
        </div>

        <div class="spec-grid">
          <article class="spec-card">
            <strong data-product-spec-label="0">Désignation</strong>
            <h3 class="product-name" data-product-spec-value="0">{{ product_name }}</h3>
            <p class="muted" data-product-spec-text="0">Nom commercial affiché dans le catalogue.</p>
          </article>
          <article class="spec-card">
            <strong data-product-spec-label="1">Catégorie</strong>
            <h3 class="product-name" data-product-spec-value="1">{{ product_category }}</h3>
            <p class="muted" data-product-spec-text="1">Relation Doctrine avec l'entité Catégorie.</p>
          </article>
          <article class="spec-card">
            <strong data-product-spec-label="2">Stock</strong>
            <h3 class="product-name" data-product-spec-value="2">{{ produit ? produit.stock : 'Demo' }}</h3>
            <p class="muted" data-product-spec-text="2">Valeur exploitable ensuite par le panier.</p>
          </article>
          <article class="spec-card">
            <strong data-product-spec-label="3">Prix HT</strong>
            <h3 class="product-name" data-product-spec-value="3">{{ product_price }}</h3>
            <p class="muted" data-product-spec-text="3">Prix actuel du produit.</p>
          </article>
        </div>

        <div class="requirements-panel glass-panel">
          <div class="stack-md">
            <div class="eyebrow eyebrow-bright">Intégration Symfony</div>
            <div class="requirements-grid">
              <div class="requirements-list">
                <div class="requirements-row">
                  <span class="meta-text" data-product-requirement-label="0">Route</span>
                  <span data-product-requirement-value="0">{{ produit ? path('app_produit_show', { id: produit.id }) : path('app_produit_demo') }}</span>
                </div>
                <div class="requirements-row">
                  <span class="meta-text" data-product-requirement-label="1">Panier</span>
                  <span data-product-requirement-value="1">{{ cart_path }}</span>
                </div>
              </div>
              <div class="requirements-note">
                <div class="eyebrow eyebrow-bright">Note technique</div>
                <p class="muted" data-product-note">
                  Les images de galerie proviennent de la table produit_image, et l'image principale reste utilisée dans les cartes catalogue.
                </p>
              </div>
            </div>
          </div>
        </div>

        <section class="reviews-layout">
          {% if app.user and noterForm %}
            {% include 'components/_form_panel.html.twig' with {
              form: noterForm,
              title: 'Donner_un_avis',
              kicker: product_name,
              submit_label: 'Envoyer',
              back_path: null
            } only %}
          {% else %}
            <article class="form-panel panel">
              <div class="stack-lg">
                <div>
                  <div class="eyebrow eyebrow-bright">Avis produit</div>
                  <h2 class="product-name">Retour_Client</h2>
                </div>

                {% include 'components/_flash_messages.html.twig' ignore missing %}

                {% if app.user and userReview %}
                  <div class="requirements-panel glass-panel">
                    <p class="muted">Vous avez déjà donné un avis pour ce produit.</p>
                  </div>
                {% elseif not app.user %}
                  <div class="requirements-panel glass-panel">
                    <p class="muted">
                      <a class="eyebrow eyebrow-bright" href="{{ path('app_login') }}">Connectez-vous</a>
                      pour donner votre avis.
                    </p>
                  </div>
                {% endif %}
              </div>
            </article>
          {% endif %}

          <article class="admin-card padded">
            <div class="stack-md">
              <div>
                <div class="eyebrow eyebrow-bright">Avis existants</div>
                <h2 class="product-name">{{ produit ? produit.noters|length : 0 }} message(s)</h2>
              </div>

              {% if produit and produit.noters|length > 0 %}
                <div class="review-list">
                  {% for avis in produit.noters %}
                    <div class="review-item">
                      <div class="mini-row">
                        <strong>{{ avis.user ? avis.user.email : 'Client' }}</strong>
                        <span class="meta-text">{{ avis.dateMessage ? avis.dateMessage|date('d/m/Y') : '' }}</span>
                      </div>
                      <p class="muted">{{ avis.message }}</p>
                    </div>
                  {% endfor %}
                </div>
              {% else %}
                <p class="muted">Aucun avis pour ce produit.</p>
              {% endif %}
            </div>
          </article>
        </section>
      </div>
    </section>
  </main>
{% endblock %}
