{% extends 'base.html.twig' %}

{% set is_demo = demo_mode|default(false) %}
{% set product_name = produit ? produit.designation : 'Command Center' %}
{% set product_price = produit ? produit.prixUnitHT ~ ' EUR' : '149,99 EUR' %}
{% set product_description = produit ? produit.description : "Console de pilotage compacte pour lancer vos scènes, overlays et macros sans quitter l'écran principal. Une vraie tour de contrôle pour le setup." %}
{% set product_category = produit and produit.categorie ? produit.categorie.nomCategorie : 'Console modulaire' %}
{% set product_gallery = produit ? produit.images : [] %}
{% set raw_image = produit ? produit.image : 'https://lh3.googleusercontent.com/aida-public/AB6AXuDZUd-zzhzhAwqcvVN5x5xiWvonJvYqPAkq0-VDcd0aCS63A6R_t0PQvISa5_NAig1uME07IzXOJNXHelnRUs_By0otGuKb2EDXVChqpX070n8cok3eul7x_uOw21uugQsspPJR7uEh6Hhpa8xlsb5KsaQuYscb0Mrb8O3jSOZ1z5NBLFbau_3-tOJMW7dqXyMJakzEzgkWA5ibVFFJsCbsGa6Snfh9fcAgohgQ46LdAZjQRDeLDsYPOsE5UzHblvRIbyt0SelZa2s' %}
{% set product_image = (raw_image starts with 'http' or raw_image starts with '/') ? raw_image : '/assets/images/products/' ~ raw_image %}
{% set primary_in_gallery = product_gallery|filter(image => image.filename == raw_image)|length > 0 %}
{% set cart_path = produit ? path('app_panier_add', { id: produit.id }) : path('app_catalogue') %}
{% set favorite_path = produit ? path('app_favoris', { id: produit.id }) : path('app_login') %}
{% set is_favorite = app.user and produit and produit in app.user.produitsAimers %}
{% set rating_count = ratingCount|default(0) %}
{% set average_rating = averageRating|default(null) %}
{% set average_rating_rounded = averageRatingRounded|default(0) %}

{% block title %}StreamCorner | {{ product_name }}{% endblock %}
{% block body_class %}page-shell product-page{% endblock %}
{% block body_data %}data-nav-section="boutique"{% if is_demo %} data-product-page="true"{% endif %}{% endblock %}

{% block body %}
  <main>
    <section class="section">
      <div class="container stack-lg">
        <div class="product-layout">
          <section>
            <div class="gallery-main">
              <img data-gallery-main src="{{ product_image }}" alt="{{ product_name }}">
            </div>

            <div class="gallery-thumbs">
              {% if product_gallery|length > 0 %}
                {% for image in product_gallery %}
                  {% set gallery_src = (image.filename starts with 'http' or image.filename starts with '/') ? image.filename : '/assets/images/products/' ~ image.filename %}
                  {% set is_primary_thumb = image.filename == raw_image %}
                  <button
                    class="gallery-thumb {{ is_primary_thumb ? 'is-active' : '' }}"
                    type="button"
                    data-gallery-thumb
                    data-product-gallery-slot="{{ loop.index0 }}"
                    data-gallery-src="{{ gallery_src }}"
                    data-gallery-alt="{{ image.alt ?: product_name }}"
                    aria-label="{{ image.alt ?: product_name }}"
                  >
                    <img src="{{ gallery_src }}" alt="{{ image.alt ?: product_name }}">
                  </button>
                {% endfor %}
                {% if not primary_in_gallery %}
                  <button
                    class="gallery-thumb is-active"
                    type="button"
                    data-gallery-thumb
                    data-product-gallery-slot="primary"
                    data-gallery-src="{{ product_image }}"
                    data-gallery-alt="{{ product_name }}"
                    aria-label="{{ product_name }}"
                  >
                    <img src="{{ product_image }}" alt="{{ product_name }}">
                  </button>
                {% endif %}
              {% else %}
                <button
                  class="gallery-thumb is-active"
                  type="button"
                  data-gallery-thumb
                  data-product-gallery-slot="0"
                  data-gallery-src="{{ product_image }}"
                  data-gallery-alt="{{ product_name }}"
                  aria-label="{{ product_name }}"
                >
                  <img src="{{ product_image }}" alt="{{ product_name }}">
                </button>
              {% endif %}
            </div>
          </section>

          <aside class="product-summary">
            <div class="summary-panel panel">
              <div class="stack-md">
                <div class="pill" data-product-pill>{{ product_category }}</div>
                <h1 class="section-title" data-product-title>{{ product_name }}</h1>
                <p class="summary-copy" data-product-summary>{{ product_description }}</p>

                <div class="stock-note">
                  <span data-product-stock-text>{{ produit and produit.stock <= 0 ? 'Rupture' : 'En stock' }}</span>
                  <span class="eyebrow eyebrow-bright" data-product-stock-meta>{{ produit ? produit.stock ~ ' unité(s)' : 'Livraison 48h' }}</span>
                </div>

                <div class="rating-summary">
                  <div class="star-rating" aria-label="{{ average_rating is not null ? 'Note moyenne ' ~ average_rating|number_format(1, ',', ' ') ~ ' sur 5' : 'Aucune note produit' }}">
                    {% for star in 1..5 %}
                      <span class="{{ star <= average_rating_rounded ? 'is-filled' : '' }}">★</span>
                    {% endfor %}
                  </div>
                  <div>
                    <strong>{{ average_rating is not null ? average_rating|number_format(1, ',', ' ') ~ '/5' : 'Aucune note' }}</strong>
                    <span class="rating-summary-count">{{ rating_count }} avis noté{{ rating_count > 1 ? 's' : '' }}</span>
                  </div>
                </div>

                <div class="price-row">
                  <span class="price-value" data-product-price>{{ product_price }}</span>
                  <span class="meta-text" data-product-price-note>Prix HT</span>
                </div>

                <div class="summary-actions">
                  <a
                    class="btn btn-primary {{ produit and produit.stock <= 0 ? 'is-disabled' : '' }}"
                    href="{{ app.user ? cart_path : path('app_login') }}"
                    data-product-buy
                    {% if app.user and produit and produit.stock > 0 %}
                      data-cart-action
                      data-cart-action-type="add"
                      data-product-id="{{ produit.id }}"
                    {% endif %}
                    aria-disabled="{{ produit and produit.stock <= 0 ? 'true' : 'false' }}"
                  >
                    <span class="material-symbols-outlined">shopping_cart</span>
                    <span data-cart-action-label>{{ produit and produit.stock <= 0 ? 'Rupture' : 'Ajouter au panier' }}</span>
                  </a>
                  <a
                    class="btn btn-secondary {{ is_favorite ? 'is-active' : '' }}"
                    href="{{ app.user ? favorite_path : path('app_login') }}"
                    data-product-favorite
                    {% if app.user and produit %}
                      data-favorite-toggle
                      data-product-id="{{ produit.id }}"
                    {% endif %}
                    aria-label="{{ is_favorite ? 'Retirer des favoris' : 'Ajouter aux favoris' }}"
                    aria-pressed="{{ is_favorite ? 'true' : 'false' }}"
                  >
                    <span class="material-symbols-outlined">favorite</span>
                    <span data-favorite-label>{{ is_favorite ? 'Retirer des favoris' : 'Ajouter aux favoris' }}</span>
                  </a>
                </div>
              </div>

              <div class="summary-specs">
                <div>
                  <strong data-product-summary-spec-label="0">Catégorie</strong>
                  <span data-product-summary-spec-value="0">{{ product_category }}</span>
                </div>
                <div>
                  <strong data-product-summary-spec-label="1">Stock</strong>
                  <span data-product-summary-spec-value="1">{{ produit ? produit.stock ~ ' unité(s)' : 'Disponible' }}</span>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container stack-lg">
        <div class="split-header">
          <div>
            <h2 class="section-title">Pourquoi_<em>le choisir</em></h2>
            <p class="muted">Un aperçu clair de ce que ce produit apporte à votre setup avant de passer commande.</p>
          </div>
        </div>

        <div class="spec-grid product-benefit-grid">
          <article class="spec-card">
            <strong>Usage</strong>
            <h3 class="product-name">{{ product_category }}</h3>
            <p class="muted">Un équipement conçu pour s'intégrer naturellement dans un setup de streaming, de création ou de jeu.</p>
          </article>
          <article class="spec-card">
            <strong>Accompagnement</strong>
            <h3 class="product-name">Conseil & support</h3>
            <p class="muted">Une question sur la compatibilité ou le choix du matériel ? Le support peut vous orienter avant l'achat.</p>
          </article>
        </div>

        <div class="split-header">
          <div>
            <div class="eyebrow eyebrow-bright">Avis produit</div>
            <h2 class="section-title">Retours_<em>clients</em></h2>
          </div>
        </div>

        <section class="reviews-layout">
          {% if app.user and noterForm %}
            {% include 'components/_form_panel.html.twig' with {
              form: noterForm,
              title: 'Donner_un_avis',
              kicker: product_name,
              submit_label: 'Envoyer',
              back_path: null
            } only %}
          {% else %}
            <article class="form-panel panel">
              <div class="stack-lg">
                <div>
                  <div class="eyebrow eyebrow-bright">Avis produit</div>
                  <h2 class="product-name">Donnez votre avis</h2>
                </div>

                {% include 'components/_flash_messages.html.twig' ignore missing %}

                {% if app.user and userReview %}
                  <div class="requirements-panel glass-panel">
                    <div class="review-rating">
                      <div class="star-rating" aria-label="Votre note {{ userReview.note }} sur 5">
                        {% for star in 1..5 %}
                          <span class="{{ star <= userReview.note ? 'is-filled' : '' }}">★</span>
                        {% endfor %}
                      </div>
                      <span>{{ userReview.note }}/5</span>
                    </div>
                    <p class="muted">Vous avez déjà donné un avis pour ce produit.</p>
                  </div>
                {% elseif not app.user %}
                  <div class="requirements-panel glass-panel">
                    <p class="muted">
                      <a class="eyebrow eyebrow-bright" href="{{ path('app_login') }}">Connectez-vous</a>
                      pour donner votre avis.
                    </p>
                  </div>
                {% endif %}
              </div>
            </article>
          {% endif %}

          <article class="admin-card padded">
            <div class="stack-md">
              <div>
                <div class="eyebrow eyebrow-bright">Avis existants</div>
                <h2 class="product-name">{{ produit ? produit.noters|length : 0 }} message(s)</h2>
              </div>

              {% if produit and produit.noters|length > 0 %}
                <div class="review-list">
                  {% for avis in produit.noters %}
                    <div class="review-item">
                      <div class="mini-row">
                        <strong>{{ avis.user ? avis.user.email : 'Client' }}</strong>
                        <span class="meta-text">{{ avis.dateMessage ? avis.dateMessage|date('d/m/Y') : '' }}</span>
                      </div>
                      <div class="review-rating">
                        <div class="star-rating" aria-label="Note {{ avis.note }} sur 5">
                          {% for star in 1..5 %}
                            <span class="{{ star <= avis.note ? 'is-filled' : '' }}">★</span>
                          {% endfor %}
                        </div>
                        <span>{{ avis.note }}/5</span>
                      </div>
                      <p class="muted">{{ avis.message }}</p>
                    </div>
                  {% endfor %}
                </div>
              {% else %}
                <p class="muted">Aucun avis pour ce produit.</p>
              {% endif %}
            </div>
          </article>
        </section>
      </div>
    </section>
  </main>
{% endblock %}
