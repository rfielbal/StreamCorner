{% extends 'base.html.twig' %}

{% set selectedCategories = selectedCategories|default([]) %}
{% set currentSort = sort|default('newest') %}
{% set currentMaxPrice = maxPrice|default('2000') %}
{% set onlyInStock = inStock|default(false) %}
{% set filter_route = searchTerm ? 'app_resultat' : 'app_catalogue' %}
{% set reset_params = searchTerm ? { q: searchTerm } : {} %}
{% set activeFilterCount = selectedCategories|length + (currentMaxPrice != '2000' ? 1 : 0) + (onlyInStock ? 1 : 0) %}

{% block title %}StreamCorner | Catalogue{% endblock %}
{% block body_class %}page-shell{% endblock %}
{% block body_data %}data-nav-section="boutique"{% endblock %}

{% block body %}
  <div class="sidebar-backdrop" id="catalogue-overlay" data-close-target="#catalogue-filters, #catalogue-overlay"></div>

  <main class="container">
    <div class="catalog-layout">
      <aside class="catalog-sidebar" id="catalogue-filters">
        <form id="catalogue-filter-form" class="stack-lg catalog-filter-form" method="get" action="{{ path(filter_route) }}" data-catalogue-filter-form>
          {% if searchTerm %}
            <input type="hidden" name="q" value="{{ searchTerm }}">
          {% endif %}

          <div class="catalog-sidebar-header">
            <div>
              <div class="eyebrow eyebrow-bright">Centre de commande</div>
              <h1 class="product-name">SYSTEME_ACTIF</h1>
            </div>
            <button class="catalog-sidebar-close" type="button" data-close-target="#catalogue-filters, #catalogue-overlay" aria-label="Fermer les filtres">
              <span class="material-symbols-outlined">close</span>
            </button>
          </div>

          <section class="filter-group">
            <h2 class="filter-label">Catégorie</h2>
            <div class="filter-options">
              <label class="checkbox-line">
                <input
                  type="checkbox"
                  name="all_categories"
                  value="1"
                  data-filter-all-categories
                  {{ selectedCategories is empty ? 'checked' : '' }}
                >
                Tout le matériel
              </label>
              {% for categorie in categories %}
                <label class="checkbox-line">
                  <input
                    type="checkbox"
                    name="categories[]"
                    value="{{ categorie.id }}"
                    data-filter-category
                    {{ categorie.id ~ '' in selectedCategories ? 'checked' : '' }}
                  >
                  {{ categorie.nomCategorie }}
                </label>
              {% else %}
                <p class="muted filter-empty">Ajoutez d'abord une catégorie depuis l'administration.</p>
              {% endfor %}
            </div>
          </section>

          <section class="filter-group">
            <h2 class="filter-label">Prix maximum</h2>
            <input id="catalogue-max-price" type="range" name="max_price" min="0" max="2000" step="10" value="{{ currentMaxPrice }}" data-filter-price>
            <div class="mini-row muted">
              <span>0 EUR</span>
              <span data-filter-price-output>{{ currentMaxPrice == '2000' ? '2 000 EUR+' : currentMaxPrice ~ ' EUR' }}</span>
            </div>
          </section>

          <section class="filter-group">
            <h2 class="filter-label">Disponibilité</h2>
            <div class="filter-options">
              <label class="checkbox-line">
                <input type="checkbox" name="in_stock" value="1" {{ onlyInStock ? 'checked' : '' }}>
                En stock uniquement
              </label>
            </div>
          </section>

          <div class="filter-actions">
            <button class="btn btn-primary" type="submit">Appliquer</button>
            <a class="btn btn-ghost" href="{{ path(filter_route, reset_params) }}">Réinitialiser</a>
          </div>

          <div class="filter-status meta-text" data-filter-status>
            {{ activeFilterCount > 0 ? activeFilterCount ~ ' filtre(s) actif(s)' : 'Tous les produits' }}
          </div>
        </form>
      </aside>

      <section class="catalog-main">
        <div class="catalog-toolbar">
          <div class="stack-sm">
            <h1 class="section-title">Catalogue_Produits</h1>
            <div class="pill">Inventaire actif</div>
          </div>
          <div class="toolbar-actions">
            <button class="panel-toggle" type="button" data-toggle-target="#catalogue-filters, #catalogue-overlay" aria-label="Ouvrir les filtres">
              <span class="material-symbols-outlined">tune</span>
            </button>
            <label class="toolbar-sort" for="catalog-sort">
              Trier
              <select id="catalog-sort" name="sort" form="catalogue-filter-form" onchange="this.form.submit()">
                <option value="newest" {{ currentSort == 'newest' ? 'selected' : '' }}>Nouveautés</option>
                <option value="name_asc" {{ currentSort == 'name_asc' ? 'selected' : '' }}>Nom A-Z</option>
                <option value="name_desc" {{ currentSort == 'name_desc' ? 'selected' : '' }}>Nom Z-A</option>
                <option value="price_asc" {{ currentSort == 'price_asc' ? 'selected' : '' }}>Prix croissant</option>
                <option value="price_desc" {{ currentSort == 'price_desc' ? 'selected' : '' }}>Prix décroissant</option>
                <option value="stock_desc" {{ currentSort == 'stock_desc' ? 'selected' : '' }}>Stock</option>
              </select>
              <span class="material-symbols-outlined">expand_more</span>
            </label>
          </div>
        </div>

        <div class="product-grid catalog-grid" id="catalogue-grid">
          {% if produits is not empty %}
            {% for produit in produits %}
              {% set raw_image = produit.image %}
              {% set image_src = (raw_image starts with 'http' or raw_image starts with '/') ? raw_image : '/assets/images/products/' ~ raw_image %}
              {% set category_name = produit.categorie ? produit.categorie.nomCategorie : 'Matériel streaming' %}
              {% set category_key = category_name|lower %}
              {% set is_favorite = user and produit in user.produitsAimers %}
              <article class="product-card" id="produit-{{ produit.id }}">
                {% if 'audio' in category_key %}
                  <span class="catalog-anchor" id="audio" aria-hidden="true"></span>
                {% elseif 'eclairage' in category_key or 'light' in category_key %}
                  <span class="catalog-anchor" id="eclairage" aria-hidden="true"></span>
                {% endif %}
                <a
                  class="product-favorite btn-icon {{ is_favorite ? 'is-active' : '' }}"
                  href="{{ app.user ? path('app_favoris', { id: produit.id }) : path('app_login') }}"
                  aria-label="{{ is_favorite ? 'Retirer des favoris' : 'Ajouter aux favoris' }}"
                  aria-pressed="{{ is_favorite ? 'true' : 'false' }}"
                  {% if app.user %}
                    data-favorite-toggle
                    data-product-id="{{ produit.id }}"
                  {% endif %}
                >
                  <span class="material-symbols-outlined">favorite</span>
                </a>
                <div class="product-media">
                  <img src="{{ image_src }}" alt="{{ produit.designation }}">
                </div>
                <div class="product-body">
                  <div class="eyebrow eyebrow-bright">{{ category_name }}</div>
                  <div class="product-meta">
                    <h2 class="product-name">{{ produit.designation }}</h2>
                    <div class="price-value">{{ produit.prixUnitHT }} EUR</div>
                  </div>
                  <p class="product-description">{{ produit.description|striptags|slice(0, 140) }}{% if produit.description|length > 140 %}...{% endif %}</p>
                  <div class="product-card-actions">
                    <a class="btn btn-secondary" href="{{ path('app_produit_show', { id: produit.id }) }}">Voir la fiche</a>
                    {% if produit.stock > 0 %}
                      <a
                        class="btn btn-primary"
                        href="{{ app.user ? path('app_panier_add', { id: produit.id }) : path('app_login') }}"
                        {% if app.user %}
                          data-cart-action
                          data-cart-action-type="add"
                          data-product-id="{{ produit.id }}"
                        {% endif %}
                      >
                        <span class="material-symbols-outlined">add_shopping_cart</span>
                        <span data-cart-action-label>Ajouter</span>
                      </a>
                    {% else %}
                      <span class="btn btn-secondary is-disabled" aria-disabled="true">Rupture</span>
                    {% endif %}
                  </div>
                </div>
              </article>
            {% endfor %}
          {% else %}
            <article class="catalog-empty-state panel">
              <div class="stack-md">
                <div class="eyebrow eyebrow-bright">Catalogue vide</div>
                <h2 class="product-name">{{ searchTerm ? 'Aucun résultat' : 'Aucun produit enregistré' }}</h2>
                <p class="muted">
                  {{ searchTerm
                    ? 'Aucun produit de la base ne correspond à cette recherche ou à ces filtres.'
                    : 'Ajoutez des catégories et des produits depuis l’administration pour alimenter cette page.'
                  }}
                </p>
                {% if is_granted('ROLE_ADMIN') %}
                  <a class="btn btn-primary" href="{{ path('app_admin_crud_new', { resource: 'produits' }) }}">
                    <span class="material-symbols-outlined">add</span>
                    Ajouter un produit
                  </a>
                {% endif %}
              </div>
            </article>
          {% endif %}
        </div>
      </section>
    </div>
  </main>
{% endblock %}
