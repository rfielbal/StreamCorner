{% extends 'base.html.twig' %}

{% block title %}StreamCorner | Commande #{{ commande.id }}{% endblock %}
{% block body_class %}page-shell{% endblock %}

{% block body %}
  <main class="section">
    <div class="container stack-lg">
      <div class="split-header">
        <div>
          <h1 class="section-title">Commande_{{ commande.id }}</h1>
          <p class="section-kicker">{{ commande.dateCommande|date('d/m/Y H:i') }}</p>
        </div>
        <a class="btn btn-secondary" href="{{ path('app_commande_index') }}">
          <span class="material-symbols-outlined">arrow_back</span>
          Retour
        </a>
      </div>

      {% include 'components/_flash_messages.html.twig' ignore missing %}

      <section class="order-detail-layout">
        <article class="admin-card padded">
          <div class="stack-md">
            <div>
              <div class="eyebrow eyebrow-bright">Lignes commande</div>
              <h2 class="product-name">{{ commande.parvenirs|length }} produit(s)</h2>
            </div>

            <div class="order-line-list">
              {% for ligne in commande.parvenirs %}
                {% set produit = ligne.produit %}
                {% set raw_image = produit ? produit.image : '' %}
                {% set image_src = raw_image ? ((raw_image starts with 'http' or raw_image starts with '/') ? raw_image : '/assets/images/products/' ~ raw_image) : null %}
                <article class="order-line-card">
                  <div class="order-line-media">
                    {% if produit and image_src %}
                      <img src="{{ image_src }}" alt="{{ produit.designation }}">
                    {% else %}
                      <span class="material-symbols-outlined" aria-hidden="true">inventory_2</span>
                    {% endif %}
                  </div>

                  <div class="order-line-main">
                    <div class="order-line-heading">
                      <div>
                        <h3 class="order-line-title product-name">{{ produit ? produit.designation : 'Produit supprimé' }}</h3>
                        <div class="eyebrow eyebrow-bright">Prix unitaire HT</div>
                      </div>
                      <strong class="order-line-unit">{{ ligne.prixHt|number_format(2, ',', ' ') }} €</strong>
                    </div>

                    <div class="order-line-meta">
                      <div class="order-line-stat">
                        <span class="order-line-label">Quantité</span>
                        <strong class="order-line-value">{{ ligne.quantite }}</strong>
                      </div>
                      <div class="order-line-stat">
                        <span class="order-line-label">Sous-total HT</span>
                        <strong class="order-line-value">{{ (ligne.quantite * ligne.prixHt)|number_format(2, ',', ' ') }} €</strong>
                      </div>
                    </div>
                  </div>
                </article>
              {% endfor %}
            </div>

            <div class="summary-total">
              <div class="row muted"><span>Total HT</span><span>{{ commande.totalHtCo|number_format(2, ',', ' ') }} €</span></div>
              <div class="row muted"><span>TVA</span><span>{{ commande.totalTaxe|number_format(2, ',', ' ') }} €</span></div>
              <div class="row"><span class="product-name">Total TTC</span><span class="grand-total">{{ commande.total|number_format(2, ',', ' ') }} €</span></div>
            </div>
          </div>
        </article>

        <aside class="order-side-stack stack-md">
          {% include 'components/_form_panel.html.twig' with {
            form: addressForm,
            title: "Modifier_l'adresse",
            kicker: 'Livraison #SC-' ~ commande.id,
            submit_label: "Modifier l'adresse",
            back_path: null
          } %}

          <article class="admin-card padded order-cancel-panel">
            <div class="stack-md">
              <div>
                <div class="eyebrow eyebrow-bright">Annulation</div>
                <h2 class="product-name">Annuler_la_commande</h2>
                <p class="muted">Cette action supprime la commande et remet les produits concernés en stock.</p>
              </div>

              <form method="post" action="{{ path('app_commande_cancel', { id: commande.id }) }}" onsubmit="return confirm('Annuler définitivement cette commande ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('cancel-commande-' ~ commande.id) }}">
                <button class="btn btn-secondary danger-action" type="submit">
                  <span class="material-symbols-outlined">cancel</span>
                  Annuler la commande
                </button>
              </form>
            </div>
          </article>

          {% include 'components/_form_panel.html.twig' with {
            form: savForm,
            title: 'Contacter_le_SAV',
            kicker: 'Commande #' ~ commande.id,
            submit_label: 'Envoyer',
            back_path: null
          } %}
        </aside>
      </section>
    </div>
  </main>
{% endblock %}
