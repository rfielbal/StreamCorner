{% extends 'base.html.twig' %}

{% block title %}StreamCorner | Administration{% endblock %}
{% block body_class %}{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
  {% set readonly = admin_readonly|default(false) %}
  <div class="sidebar-backdrop" id="admin-overlay" data-close-target="#admin-sidebar, #admin-overlay"></div>

  <div class="admin-shell">
    {% include 'admin/_sidebar.html.twig' with { admin_active: 'dashboard', sidebar_id: 'admin-sidebar' } %}

    <main class="admin-main">
      <header class="admin-topline">
        <div class="stack-sm">
          <button class="mobile-sidebar-toggle mobile-only" type="button" data-toggle-target="#admin-sidebar, #admin-overlay" aria-label="Ouvrir la sidebar admin">
            <span class="material-symbols-outlined">menu</span>
          </button>
          <h1 class="section-title">Profil_Admin</h1>
          <p class="section-kicker">Accès centralisé aux tables du projet</p>
        </div>

        <div class="admin-header-actions">
          <div class="metric-strip">
            {% for metric in metrics %}
              <div class="metric-chip">
                <strong>{{ metric.label }}</strong>
                <span class="metric-{{ metric.tone }}">{{ metric.value }}</span>
              </div>
            {% endfor %}
          </div>
          {% include 'admin/_quick_actions.html.twig' %}
        </div>
      </header>

      <section class="admin-hub-layout">
        <aside class="admin-card admin-profile-panel">
          <div class="admin-profile-mark">
            <span class="material-symbols-outlined">admin_panel_settings</span>
          </div>
          <div class="stack-md">
            <div>
              <div class="eyebrow eyebrow-bright">Session</div>
              <h2 class="product-name">{{ app.user ? app.user.userIdentifier : 'Session_Locale' }}</h2>
            </div>
            <div class="admin-profile-list">
              <div>
                <span>Role actif</span>
                <strong>{{ is_granted('ROLE_ADMIN') ? 'ROLE_ADMIN' : (readonly ? 'ROLE_VISITEUR' : (app.user ? 'ROLE_USER' : 'MODE_DEV')) }}</strong>
              </div>
              <div>
                <span>CRUD</span>
                <strong>{{ readonly ? 'Lecture seule' : 'Actif' }}</strong>
              </div>
              <div>
                <span>Formulaires</span>
                <strong>{{ readonly ? 'Consultables' : 'Branchés' }}</strong>
              </div>
            </div>
          </div>
        </aside>

        <section class="admin-management-grid">
          {% for section in admin_sections %}
            <article class="admin-card admin-management-card">
              <div class="admin-management-head">
                <span class="admin-management-icon material-symbols-outlined">{{ section.icon }}</span>
                <span class="status-badge {{ section.active ? 'status-success' : '' }}">{{ section.count }}</span>
              </div>
              <div class="stack-sm">
                <h2 class="product-name">{{ section.label }}</h2>
                <p class="muted">{{ section.description }}</p>
              </div>
              <div class="admin-action-set">
                <a class="btn btn-secondary" href="{{ path('app_admin_crud_index', { resource: section.resource }) }}">Lister</a>
                <a class="btn btn-ghost" href="{{ path('app_admin_crud_new', { resource: section.resource }) }}">{{ readonly ? 'Voir formulaire' : 'Ajouter' }}</a>
              </div>
            </article>
          {% endfor %}
        </section>
      </section>

      <section class="admin-card admin-subject-panel">
        <div class="table-controls">
          <div>
            <h2 class="product-name">Couverture_Sujet</h2>
            <p class="muted">Retrouvez les outils essentiels pour piloter la boutique, les produits, les commandes et les échanges clients.</p>
          </div>
          <span class="status-badge status-info">{{ readonly ? 'Mode visiteur' : 'Option profil admin' }}</span>
        </div>
        <div class="admin-check-grid">
          <div>
            <span class="material-symbols-outlined">check_circle</span>
            <strong>Lister chaque table</strong>
          </div>
          <div>
            <span class="material-symbols-outlined">{{ readonly ? 'visibility' : 'pending_actions' }}</span>
            <strong>{{ readonly ? 'Voir les formulaires' : 'Ajouter par formulaire' }}</strong>
          </div>
          <div>
            <span class="material-symbols-outlined">{{ readonly ? 'lock' : 'pending_actions' }}</span>
            <strong>{{ readonly ? 'Modifications verrouillées' : 'Modifier par formulaire' }}</strong>
          </div>
          <div>
            <span class="material-symbols-outlined">{{ readonly ? 'lock' : 'pending_actions' }}</span>
            <strong>{{ readonly ? 'Suppressions verrouillées' : 'Supprimer par action sécurisée' }}</strong>
          </div>
        </div>
      </section>

      <footer class="admin-footer">
        <div class="footer-grid">
          <div class="footer-links">
            <a href="{{ path('app_accueil') }}">Boutique</a>
            <a href="{{ path('app_catalogue') }}">Catalogue public</a>
            <a href="{{ path('app_logout') }}">Déconnexion</a>
          </div>
          <p class="footer-copy">Administration StreamCorner alignée sur les tables Produit, Categorie, Commande, Utilisateur, Adresse, Panier, SAV et droits.</p>
        </div>
      </footer>
    </main>
  </div>
{% endblock %}
