{% extends 'base.html.twig' %}

{% block title %}StreamCorner | {{ title|replace({'_': ' '}) }}{% endblock %}
{% block body_class %}{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
  {% set readonly = admin_readonly|default(false) %}
  <div class="sidebar-backdrop" id="{{ overlay_id }}" data-close-target="#{{ sidebar_id }}, #{{ overlay_id }}"></div>

  <div class="admin-shell">
    {% include 'admin/_sidebar.html.twig' with { admin_active: admin_active, sidebar_id: sidebar_id } %}

    <main class="admin-main">
      <header class="admin-topline">
        <div class="stack-sm">
          <button class="mobile-sidebar-toggle mobile-only" type="button" data-toggle-target="#{{ sidebar_id }}, #{{ overlay_id }}" aria-label="Ouvrir la sidebar admin">
            <span class="material-symbols-outlined">menu</span>
          </button>
          <h1 class="section-title">{{ title }}</h1>
          <p class="section-kicker">{{ kicker }}</p>
        </div>

        <div class="admin-header-actions">
          <a class="btn btn-secondary" href="{{ back_path }}">
            <span class="material-symbols-outlined">arrow_back</span>
            Retour
          </a>
          {% include 'admin/_quick_actions.html.twig' %}
        </div>
      </header>

      {% include 'components/_flash_messages.html.twig' ignore missing %}

      <section class="admin-form-layout">
        {% include 'components/_form_panel.html.twig' with {
          form: form,
          title: title,
          kicker: kicker,
          submit_label: submit_label,
          back_path: back_path,
          readonly: readonly,
          readonly_message: 'Mode visiteur : ce formulaire est affiché pour comprendre le fonctionnement admin, sans enregistrement possible.'
        } %}

        {% if resource|default(null) == 'produits' and entity is defined and entity.id %}
          <article class="admin-product-images-panel panel">
            <div class="stack-lg">
              <div class="profile-section-head">
                <div>
                  <div class="eyebrow eyebrow-bright">Galerie produit</div>
                  <h2 class="product-name">Images_Actuelles</h2>
                </div>
                <span class="status-badge {{ readonly ? 'status-info' : 'status-success' }}">{{ readonly ? 'Lecture seule' : entity.images|length ~ ' image(s)' }}</span>
              </div>

              {% if entity.images|length > 0 %}
                <div class="admin-product-image-grid">
                  {% for image in entity.images %}
                    {% set raw_image = image.filename %}
                    {% set image_src = (raw_image starts with 'http' or raw_image starts with '/') ? raw_image : '/assets/images/products/' ~ raw_image %}
                    {% set is_primary = image.filename == entity.image %}
                    <article class="admin-product-image-card {{ is_primary ? 'is-primary' : '' }}">
                      <div class="admin-product-image-media">
                        <img src="{{ image_src }}" alt="{{ image.alt ?: entity.designation }}">
                        {% if is_primary %}
                          <span class="status-badge status-success">Principale</span>
                        {% endif %}
                      </div>

                      <div class="admin-product-image-body">
                        <div>
                          <strong>{{ image.alt ?: entity.designation }}</strong>
                          <span class="admin-product-image-filename">{{ image.filename }}</span>
                        </div>

                        {% if readonly %}
                          <div class="admin-image-replace-form">
                            <label class="admin-image-file-label" for="replace-product-image-{{ image.id }}">
                              <span class="material-symbols-outlined">image</span>
                              <input id="replace-product-image-{{ image.id }}" type="file" name="imageFile" accept="image/jpeg,image/png,image/webp,image/gif" disabled>
                            </label>
                            <span class="btn btn-secondary is-disabled" aria-disabled="true">
                              <span class="material-symbols-outlined">sync</span>
                              Remplacer
                            </span>
                          </div>
                        {% else %}
                          <form class="admin-image-replace-form" method="post" enctype="multipart/form-data" action="{{ path('app_admin_product_image_replace', { productId: entity.id, imageId: image.id }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('replace-product-image-' ~ image.id) }}">
                            <label class="admin-image-file-label" for="replace-product-image-{{ image.id }}">
                              <span class="material-symbols-outlined">image</span>
                              <input id="replace-product-image-{{ image.id }}" type="file" name="imageFile" accept="image/jpeg,image/png,image/webp,image/gif">
                            </label>
                            <button class="btn btn-secondary" type="submit">
                              <span class="material-symbols-outlined">sync</span>
                              Remplacer
                            </button>
                          </form>
                        {% endif %}

                        <div class="admin-product-image-actions">
                          {% if readonly and not is_primary %}
                            <span class="btn btn-ghost is-disabled" aria-disabled="true">
                              <span class="material-symbols-outlined">star</span>
                              Principale
                            </span>
                          {% elseif not is_primary %}
                            <form method="post" action="{{ path('app_admin_product_image_primary', { productId: entity.id, imageId: image.id }) }}">
                              <input type="hidden" name="_token" value="{{ csrf_token('primary-product-image-' ~ image.id) }}">
                              <button class="btn btn-ghost" type="submit">
                                <span class="material-symbols-outlined">star</span>
                                Principale
                              </button>
                            </form>
                          {% endif %}

                          {% if readonly %}
                            <span class="btn btn-secondary danger-action is-disabled" aria-disabled="true">
                              <span class="material-symbols-outlined">delete</span>
                              Supprimer
                            </span>
                          {% else %}
                            <form method="post" action="{{ path('app_admin_product_image_delete', { productId: entity.id, imageId: image.id }) }}" onsubmit="return confirm('Supprimer cette image du produit et du serveur ?');">
                              <input type="hidden" name="_token" value="{{ csrf_token('delete-product-image-' ~ image.id) }}">
                              <button class="btn btn-secondary danger-action" type="submit" {{ entity.images|length <= 1 ? 'disabled' : '' }}>
                                <span class="material-symbols-outlined">delete</span>
                                Supprimer
                              </button>
                            </form>
                          {% endif %}
                        </div>
                      </div>
                    </article>
                  {% endfor %}
                </div>
              {% else %}
                <div class="profile-empty-state">
                  <span class="material-symbols-outlined">photo_library</span>
                  <div>
                    <strong>Aucune galerie</strong>
                    <p>Ajoutez une image principale ou des photos supplémentaires puis enregistrez le produit.</p>
                  </div>
                </div>
              {% endif %}
            </div>
          </article>
        {% endif %}
      </section>
    </main>
  </div>
{% endblock %}
