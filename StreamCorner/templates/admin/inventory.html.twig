{% extends 'base.html.twig' %}

{% block title %}StreamCorner | Produits{% endblock %}
{% block body_class %}{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
  <div class="sidebar-backdrop" id="inventory-overlay" data-close-target="#inventory-sidebar, #inventory-overlay"></div>

  <div class="admin-shell">
    {% include 'admin/_sidebar.html.twig' with { admin_active: 'inventory', sidebar_id: 'inventory-sidebar' } %}

    <main class="admin-main">
      <header class="admin-topline">
        <div class="stack-sm">
          <button class="mobile-sidebar-toggle mobile-only" type="button" data-toggle-target="#inventory-sidebar, #inventory-overlay" aria-label="Ouvrir la sidebar admin">
            <span class="material-symbols-outlined">menu</span>
          </button>
          <h1 class="section-title">Produits</h1>
          <p class="section-kicker">Table Produit // stock, categorie, prix HT</p>
        </div>

        <button class="btn btn-primary" type="button" aria-disabled="true" disabled>
          <span class="material-symbols-outlined">add_circle</span>
          Ajouter
        </button>
      </header>

      <section class="inventory-stats">
        <article class="admin-card stats-card primary">
          <div class="stack-sm">
            <div class="eyebrow">Références totales</div>
            <h2 class="stat-number">{{ produits|length }}</h2>
            <p class="muted">Produits actuellement enregistrés dans la table Produit.</p>
          </div>
        </article>

        <article class="admin-card stats-card secondary">
          <div class="stack-md">
            <div>
              <div class="eyebrow eyebrow-bright">Catégories</div>
              <h2 class="stat-number">{{ categories_count }}</h2>
            </div>
            <div class="mini-row">
              <span class="eyebrow">Stock bas</span>
              <span class="status-badge {{ stock_alerts > 0 ? 'status-danger' : 'status-success' }}">{{ stock_alerts }}</span>
            </div>
          </div>
        </article>
      </section>

      <section class="admin-card">
        <div class="inventory-toolbar">
          <div class="search-group">
            <input class="search-input" data-filter-table="#inventory-table" type="search" placeholder="Filtrer les produits...">
            <button class="btn-icon" type="button" aria-label="Filtrer">
              <span class="material-symbols-outlined">filter_list</span>
            </button>
          </div>

          <div class="toolbar-actions">
            <span class="status-badge status-info">{{ produits|length }} ligne(s)</span>
            <span class="status-badge">CRUD à compléter</span>
          </div>
        </div>

        <div class="table-wrap">
          <table class="data-table" id="inventory-table">
            <thead>
              <tr>
                <th>Image</th>
                <th>Produit</th>
                <th>Catégorie</th>
                <th>Prix HT</th>
                <th>Stock</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {% for produit in produits %}
                {% set raw_image = produit.image %}
                {% set image_src = (raw_image starts with 'http' or raw_image starts with '/') ? raw_image : '/assets/images/products/' ~ raw_image %}
                <tr>
                  <td>
                    <img class="table-media" src="{{ image_src }}" alt="{{ produit.designation }}">
                  </td>
                  <td>{{ produit.designation }}<br><span class="muted">ID: {{ produit.id }}</span></td>
                  <td><span class="status-badge status-info">{{ produit.categorie ? produit.categorie.nomCategorie : 'Sans catégorie' }}</span></td>
                  <td>{{ produit.prixUnitHT }} EUR</td>
                  <td>
                    <span class="status-badge {{ produit.stock > 5 ? 'status-success' : 'status-danger' }}">
                      {{ produit.stock }} unité(s)
                    </span>
                  </td>
                  <td>
                    <div class="toolbar-actions table-actions">
                      <a class="btn-icon" href="{{ path('app_produit_show', { id: produit.id }) }}" aria-label="Voir {{ produit.designation }}">
                        <span class="material-symbols-outlined">visibility</span>
                      </a>
                      <button class="btn-icon is-disabled" type="button" aria-label="Modifier {{ produit.designation }}" aria-disabled="true" disabled>
                        <span class="material-symbols-outlined">edit</span>
                      </button>
                      <button class="btn-icon is-disabled" type="button" aria-label="Supprimer {{ produit.designation }}" aria-disabled="true" disabled>
                        <span class="material-symbols-outlined">delete</span>
                      </button>
                    </div>
                  </td>
                </tr>
              {% else %}
                <tr>
                  <td class="empty-table-cell" colspan="6">Aucun produit enregistré.</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <div class="pagination">
          <span>Affichage de {{ produits|length }} résultat(s)</span>
          <div class="pagination-controls">
            <span class="page-dot is-current">1</span>
          </div>
        </div>
      </section>

      <footer class="admin-footer">
        <div class="footer-grid">
          <div class="footer-links">
            <a href="{{ path('app_admin_dashboard') }}">Profil admin</a>
            <a href="{{ path('app_admin_categories') }}">Catégories</a>
            <a href="{{ path('app_catalogue') }}">Catalogue public</a>
          </div>
          <p class="footer-copy">Liste Produit prête à recevoir les formulaires d'ajout, modification et suppression.</p>
        </div>
      </footer>
    </main>
  </div>
{% endblock %}
