<header class="topbar">
  <div class="container topbar-inner">
    <a class="brand" href="{{ path('app_accueil') }}">STREAM_CORNER</a>
    <nav class="site-nav" aria-label="Navigation principale">
      <a data-nav-item="accueil" href="{{ path('app_accueil') }}">Accueil</a>
      <div class="nav-dropdown">
        <a class="nav-dropdown-toggle" data-nav-item="boutique" href="{{ path('app_catalogue') }}" aria-haspopup="true">
          Boutique
          <span class="material-symbols-outlined">expand_more</span>
        </a>
        <div class="nav-dropdown-menu" aria-label="Catégories boutique">
          <a href="{{ path('app_catalogue', { categorie: 'diffusion' }) }}">Diffusion</a>
          <a href="{{ path('app_catalogue', { categorie: 'audio' }) }}">Audio</a>
          <a href="{{ path('app_catalogue', { categorie: 'eclairage' }) }}">Éclairage</a>
        </div>
      </div>
      <a data-nav-item="contact" href="{{ path('app_contact') }}">Contact</a>
      {% if app.user %}
        <a data-nav-item="commandes" href="{{ path('app_commande_index') }}">Commandes</a>
      {% endif %}
    </nav>
    <div class="topbar-actions">
      <form class="nav-search" method="get" action="{{ path('app_resultat') }}">
        <span class="material-symbols-outlined">search</span>
        <input type="search" name="q" placeholder="rechercher_matériel..." value="{{ app.request.query.get('q') }}">
      </form>
      <button class="nav-toggle" type="button" data-toggle-target="#mobile-nav" aria-label="Ouvrir la navigation">
        <span class="material-symbols-outlined">menu</span>
      </button>
      {% if is_granted('ROLE_ADMIN') %}
        <a class="btn-icon" data-nav-icon-item="admin" href="{{ path('app_admin_dashboard') }}" aria-label="Administration">
          <span class="material-symbols-outlined">admin_panel_settings</span>
        </a>
      {% endif %}
      <a class="btn-icon" data-nav-icon-item="favoris" href="{{ app.user ? path('app_liste_favoris') : path('app_login') }}" aria-label="Favoris">
        <span class="material-symbols-outlined">favorite</span>
      </a>
      <a class="btn-icon" data-nav-icon-item="panier" href="{{ path('app_panier') }}" aria-label="Panier">
        <span class="material-symbols-outlined">shopping_cart</span>
      </a>
      {% if app.user %}
        <a class="btn-icon" data-nav-icon-item="compte" href="{{ path('app_profil') }}" aria-label="Profil {{ app.user.userIdentifier }}">
          <span class="material-symbols-outlined">account_circle</span>
        </a>
      {% else %}
        <a class="btn-icon" data-nav-icon-item="compte" href="{{ path('app_login') }}" aria-label="Compte">
          <span class="material-symbols-outlined">account_circle</span>
        </a>
      {% endif %}
    </div>
  </div>
  <div class="container">
    <div class="mobile-nav" id="mobile-nav">
      <nav class="site-nav" aria-label="Navigation mobile">
        <a data-nav-item="accueil" href="{{ path('app_accueil') }}">Accueil</a>
        <div class="mobile-category-group">
          <a data-nav-item="boutique" href="{{ path('app_catalogue') }}">Boutique</a>
          <div class="mobile-subnav">
            <a href="{{ path('app_catalogue', { categorie: 'diffusion' }) }}">Diffusion</a>
            <a href="{{ path('app_catalogue', { categorie: 'audio' }) }}">Audio</a>
            <a href="{{ path('app_catalogue', { categorie: 'eclairage' }) }}">Éclairage</a>
          </div>
        </div>
        <a data-nav-item="contact" href="{{ path('app_contact') }}">Contact</a>
        <a href="{{ path('app_panier') }}">Panier</a>
        <a href="{{ app.user ? path('app_liste_favoris') : path('app_login') }}">Favoris</a>
        {% if is_granted('ROLE_ADMIN') %}
          <a href="{{ path('app_admin_dashboard') }}">Administration</a>
        {% endif %}
        {% if app.user %}
          <a href="{{ path('app_profil') }}">Profil</a>
          <a href="{{ path('app_commande_index') }}">Commandes</a>
          <a href="{{ path('app_adresse_index') }}">Adresses</a>
          <a href="{{ path('app_logout') }}">Déconnexion</a>
        {% else %}
          <a href="{{ path('app_login') }}">Connexion</a>
          <a href="{{ path('app_register') }}">Inscription</a>
        {% endif %}
      </nav>
    </div>
  </div>
</header>
